        /* ---- 情绪标签容器 ---- */
        .sofia-moods {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 8px;
            align-items: center;
        }

        /* 单个情绪标签 —— 仅显示文字，无 emoji */
        .sofia-mood {
            display: inline-flex;
