        }

        /* ===== 对话内容区 ===== */
        .sofia-dialogue {
            flex-grow: 1;
            padding: 18px 22px 18px 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 0;
        }

        /* 名称行：名字 + 情绪标签组 */
        .sofia-name-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 12px;
            margin-bottom: 10px;
        }

        .sofia-name {
            font-size: 15px;
            font-weight: 700;
            color: #c9a063;
            letter-spacing: 1px;
            white-space: nowrap;
