<body>
    <div id="main-container"></div>

    <script>
        // ============================================================
        //  1. 情绪 → 颜色主题分类（无 emoji）
        // ============================================================
        function getMoodTheme(emotion) {
            const positive = ['开心', '快乐', '微笑', '温柔', '温暖', '感动', '欣慰', '得意', '俏皮', '调皮', '兴奋', '期待', '害羞', '脸红', '甜蜜',
                '灿烂', '阳光', '自信', '惊喜', '激动', '爱慕', '心动', '傲娇', '天然', '元气'
            ];
            const negative = ['难过', '悲伤', '失落', '沮丧', '忧郁', '孤独', '愤怒', '生气', '恼火', '嫉妒', '焦虑', '恐惧', '害怕', '不安', '病娇',
                '黑化'
            ];
            const dramatic = ['惊喜', '感动', '激动', '震撼', '疯狂', '痴迷', '崇拜', '爱慕', '心动', '傲娇', '病娇', '黑化'];

            if (dramatic.includes(emotion)) return 'dramatic';
            if (positive.includes(emotion)) return 'positive';
            if (negative.includes(emotion)) return 'negative';
            return 'neutral';
        }

        // ============================================================
        //  2. 分割多个情绪词
        // ============================================================
        function splitEmotions(raw) {
            if (!raw || typeof raw !== 'string') return [];
            const parts = raw.split(/[,，、\/\s|]+/);
            return parts
                .map(s => s.trim())
                .filter(s => s.length > 0);
        }

        // ============================================================
        //  3. 主渲染逻辑（纯文字标签，无 emoji）
        // ============================================================
        function init() {
            try {
                let emotionRaw = `$1`;
                let textRaw = `$2`;

                const emotionList = splitEmotions(emotionRaw);
                const finalEmotions = emotionList.length > 0 ? emotionList : ['平静'];

                const text = textRaw.trim();
                if (!text || text === '$2') {
                    return; // 无对话内容则不渲染
                }

                const avatarUrl = 'https://zora404.dpdns.org/file/1783704237732_去掉人物头像框.png';

                // 构建情绪标签 HTML（只含文字）
                let moodsHtml = '';
                finalEmotions.forEach((emotion, index) => {
                    const theme = getMoodTheme(emotion);
                    const delay = index * 50;
                    moodsHtml += `
                        <span class="sofia-mood mood-${theme}" style="animation: fadeInSofia 0.4s ease ${delay}ms both;">
                            ${emotion}
                        </span>
                    `;
                });

                const html = `
                    <div class="sofia-wrapper">
                        <div class="sofia-avatar" id="sofia-avatar-container">
                            <img
                                src="${avatarUrl}"
                                alt="索菲亚"
                                loading="lazy"
                                onerror="document.getElementById('sofia-avatar-container').classList.add('img-error');"
                                onload="this.classList.add('img-loaded');"
                            >
                        </div>
                        <div class="sofia-dialogue">
                            <div class="sofia-name-row">
                                <span class="sofia-name">✧ 小圣女索菲亚</span>
                                <div class="sofia-moods">
                                    ${moodsHtml}
                                </div>
                            </div>
                            <div class="sofia-text">${text}</div>
                        </div>
                    </div>
                `;

                document.getElementById('main-container').innerHTML = html;

            } catch (error) {
                console.error('[索菲亚渲染] 错误:', error);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
</html>
