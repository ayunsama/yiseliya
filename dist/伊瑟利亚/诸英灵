            object-fit: contain;
            object-position: center;
            border-radius: 10px;
            transition: transform 0.4s ease, opacity 0.5s ease;
            opacity: 0;
            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.06));
