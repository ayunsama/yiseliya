        /* 中性 : 灰褐 / 米色系 */
        .sofia-mood.mood-neutral {
            background: #f6f3ee;
            border-color: #dcd4c8;
            color: #7a6b5a;
        }

        /* 消极 : 冷蓝 / 紫灰系 */
        .sofia-mood.mood-negative {
            background: #f0f2f6;
            border-color: #c8d0dc;
