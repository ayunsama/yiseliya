            animation: fadeInSpirit 0.5s ease-in-out;
            gap: 0;
            transition: box-shadow 0.3s ease;
        }
        .spirit-wrapper:hover {
            box-shadow: 0 6px 28px rgba(60, 40, 100, 0.2);
        }

        @keyframes fadeInSpirit {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ---- 各英灵主题色 ---- */
        .spirit-wrapper.theme-erika {
            background: linear-gradient(145deg, #fdf0ee 0%, #f8e4e0 100%);
            border: 1px solid #d4a0a0;
        }
        .spirit-wrapper.theme-ilya {
            background: linear-gradient(145deg, #eef4fa 0%, #e0eaf5 100%);
            border: 1px solid #a0bcd4;
        }
        .spirit-wrapper.theme-kori {
            background: linear-gradient(145deg, #eef6fc 0%, #dceaf5 100%);
            border: 1px solid #90b8d8;
        }
        .spirit-wrapper.theme-lilith {
            background: linear-gradient(145deg, #f5eef8 0%, #ede0f5 100%);
            border: 1px solid #c8a8d8;
        }

        /* ===== 头像区 ===== */
        .spirit-avatar {
            flex-shrink: 0;
