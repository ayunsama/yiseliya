    <script>
        /* ============================================================
         *  1. 英灵数据库
         * ============================================================ */
        var SPIRIT_META = {
            '英灵艾莉卡': {
                key: 'erika',
                icon: '⚔',
                avatar: 'https://zora404.dpdns.org/file/1784749418390_ComfyUI_00173_.jpg',
                name: '断钢的勇者·艾莉卡',
