                    '死寂': 'erika',
                    '战意': 'erika',
                    '决绝': 'erika',
                    '愤怒': 'erika',
                    '冷静': 'erika',
                    '坚定': 'erika',
                    '悲壮': 'erika',
                    '沉默': 'erika'
                }
            },
            '英灵伊利亚': {
                key: 'ilya',
                icon: '🔮',
                avatar: 'https://zora404.dpdns.org/file/1784749414890_ComfyUI_00107_.png',
                name: '燃尽的贤者·伊利亚',
                title: '第五代贤者',
                moods: {
                    '傲慢': 'ilya',
                    '睿智': 'ilya',
                    '漠然': 'ilya',
                    '平静': 'ilya',
                    '毒舌': 'ilya',
                    '尖刻': 'ilya',
                    '嘲讽': 'ilya',
                    '理智': 'ilya',
                    '疲惫': 'ilya',
                    '怀念': 'ilya',
                    '深邃': 'ilya'
                }
            },
            '英灵科里维坦': {
                key: 'kori',
                icon: '🐉',
                avatar: 'https://zora404.dpdns.org/file/1784749979790_image__79_.png',
                name: '末代的神龙·科里维坦',
                title: '第五代神龙',
                moods: {
                    '威严': 'kori',
                    '悲怆': 'kori',
                    '沉默': 'kori',
                    '面瘫': 'kori',
                    '温和': 'kori',
                    '守护': 'kori',
                    '孤寂': 'kori',
                    '沉重': 'kori',
                    '远古': 'kori',
                    '叹息': 'kori',
                    '冰冷': 'kori'
                }
            },
            '英灵莉莉丝': {
                key: 'lilith',
                icon: '🌑',
                avatar: 'https://zora404.dpdns.org/file/1784749418390_ComfyUI_00173_.jpg',
                name: '被夺的魔女·莉莉丝',
                title: '第五代魔女',
                moods: {
                    '狂热': 'lilith',
                    '诱惑': 'lilith',
                    '癫狂': 'lilith',
                    '愉悦': 'lilith',
                    '戏谑': 'lilith',
                    '恶意': 'lilith',
                    '残酷': 'lilith',
                    '病态': 'lilith',
                    '占有': 'lilith',
                    '悲愤': 'lilith',
                    '憎恨': 'lilith'
                }
            }
        };

        /* 标签前缀 → 英灵键名 */
        var TAG_MAP = {
            '英灵艾莉卡': '英灵艾莉卡',
            '英灵伊利亚': '英灵伊利亚',
            '英灵科里维坦': '英灵科里维坦',
            '英灵莉莉丝': '英灵莉莉丝'
        };

        /* ============================================================
         *  2. 分割多个情绪词
         * ============================================================ */
        function splitEmotions(raw) {
            if (!raw || typeof raw !== 'string') return [];
            var parts = raw.split(/[,，、\/\s|]+/);
            var result = [];
            for (var i = 0; i < parts.length; i++) {
                var s = parts[i].trim();
                if (s.length > 0) result.push(s);
            }
            return result;
        }

        /* ============================================================
         *  3. 主渲染逻辑
         *     标签格式: <英灵艾莉卡|冷酷>对话文本</英灵艾莉卡>
         *     正则: /<英灵\/?(艾莉卡|伊利亚|科里维坦|莉莉丝)(?:\|([^>]*))?>([\s\S]*?)<\/英灵\/?\1>/g
         *     $1 = "艾莉卡"（英灵名，无前缀）
         *     $2 = "冷酷"（情绪，可空）
         *     $3 = "对话文本"（内容）
         * ============================================================ */
        function init() {
            try {
                var spiritInput = '$1';     // 英灵名: "艾莉卡"
                var emotionRaw = '$2';      // 情绪: "冷酷"
                var textRaw = '$3';         // 对话内容

                var text = (textRaw || '').trim();
                if (!text || text === '$3') return;

                // 补全为完整键名
                var spiritTagName = '英灵' + spiritInput;
                var dbKey = TAG_MAP[spiritTagName];
                var meta = SPIRIT_META[dbKey];
                if (!meta) {
                    // 未匹配到已知英灵时输出纯文本
                    document.getElementById('main-container').innerHTML =
                        '<div style="color:#7f8c8d;padding:12px;font-family:sans-serif;">' + text + '</div>';
                    return;
                }

                var k = meta.key;

                // 解析情绪列表
                var emotionList = splitEmotions(emotionRaw);
                if (emotionList.length === 0) {
                    // 未指定情绪，根据英灵默认
                    if (k === 'erika') emotionList = ['冷静'];
                    else if (k === 'ilya') emotionList = ['平静'];
                    else if (k === 'kori') emotionList = ['沉默'];
                    else if (k === 'lilith') emotionList = ['愉悦'];
                }

                // 取情绪对应的颜色主题（默认为英灵自身主题）
                function getMoodTheme(emotion) {
                    var moodMap = meta.moods || {};
                    return moodMap[emotion] || k;
                }

                /* 构建情绪标签 HTML */
                var moodsHtml = '';
                for (var i = 0; i < emotionList.length; i++) {
                    var em = emotionList[i];
                    var theme = getMoodTheme(em);
                    var delay = i * 50;
                    moodsHtml += '<span class="spirit-mood mood-' + theme + '" style="animation: fadeInSpirit 0.4s ease ' + delay + 'ms both;">' + em + '</span>';
                }

                var html = '';
                html += '<div class="spirit-wrapper theme-' + k + '">';
                html += '  <div class="spirit-avatar" id="avatar-container">';
                html += '    <div class="avatar-icon ' + k + '">';
                html += '      <img src="' + meta.avatar + '" alt="' + meta.name + '" loading="lazy" onerror="this.parentElement.textContent=\'' + meta.icon + '\';">';
                html += '    </div>';
                html += '  </div>';
                html += '  <div class="spirit-dialogue">';
                html += '    <div class="spirit-name-row">';
                html += '      <span class="spirit-name ' + k + '">✦ ' + meta.name + '</span>';
                html += '      <span class="spirit-title-tag ' + k + '">' + meta.title + '</span>';
                html += '      <div class="spirit-moods">' + moodsHtml + '</div>';
                html += '    </div>';
                html += '    <div class="spirit-text ' + k + '">' + text + '</div>';
                html += '  </div>';
                html += '</div>';

                document.getElementById('main-container').innerHTML = html;

            } catch (error) {
                console.error('[第五代英灵渲染] 错误:', error);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
</html>
