    <script>
        // ===== 判定类型配色：按世界观三系 + 元素着色 =====
        var TYPE_COLORS = {
            '武技': { c: '#9a3b2a', i: '⚔' }, '战技': { c: '#a06020', i: '⚒' }, '魔法': { c: '#2a4a8a', i: '✧' }, '神术': { c: '#b8892a', i: '☀' },
            '火': { c: '#c0392b', i: '🔥' }, '水': { c: '#1f5fa8', i: '💧' }, '风': { c: '#2e8b74', i: '🌪️' },
            '雷': { c: '#c9a227', i: '⚡' }, '冰': { c: '#6a9ac0', i: '❄️' }, '土': { c: '#9a7a3a', i: '⛰️' },
            '符文': { c: '#3a5a4a', i: '✳️' }, '塑能': { c: '#4a3a6a', i: '✹' }, '死灵': { c: '#5a3a4a', i: '💀' }, '召唤': { c: '#4a3a6a', i: '✶' }, '暗能': { c: '#3a2a3a', i: '🌑' },
            '锻造': { c: '#8a4a1a', i: '🔨' }, '炼金': { c: '#2f6a4a', i: '⚗️' }, '工艺': { c: '#7a5a2a', i: '🛠' }
        };
        function hexA(hex, a) {
            var n = parseInt(hex.slice(1), 16);
            return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + a + ')';
        }
        function getTypeMeta(text) {
            var t = text || '';
            if (/符文/.test(t)) return TYPE_COLORS['符文'];
            if (/塑能/.test(t)) return TYPE_COLORS['塑能'];
            if (/死灵|尸术|灵术|亡灵/.test(t)) return TYPE_COLORS['死灵'];
            if (/召唤/.test(t)) return TYPE_COLORS['召唤'];
            if (/暗能|暗影|虚空/.test(t)) return TYPE_COLORS['暗能'];
            if (/神术|圣光|信仰/.test(t)) return TYPE_COLORS['神术'];
            if (/魔法|术式|术士/.test(t)) {
                if (/火/.test(t)) return TYPE_COLORS['火'];
                if (/水/.test(t)) return TYPE_COLORS['水'];
                if (/风/.test(t)) return TYPE_COLORS['风'];
                if (/雷/.test(t)) return TYPE_COLORS['雷'];
                if (/冰/.test(t)) return TYPE_COLORS['冰'];
                if (/土|岩/.test(t)) return TYPE_COLORS['土'];
                return TYPE_COLORS['魔法'];
            }
            if (/战技/.test(t)) return TYPE_COLORS['战技'];
            if (/武技|剑|斩|劈|锤|弓|枪|拳/.test(t)) return TYPE_COLORS['武技'];
            // 生产体系：锻造 / 炼金 / 工艺（附魔、制作）
            if (/锻造|打造|铁匠|熔炼|淬火|铸/.test(t)) return TYPE_COLORS['锻造'];
            if (/炼金|药剂|蒸馏|调配|魔药|药水|毒剂/.test(t)) return TYPE_COLORS['炼金'];
            if (/工艺|制作|制造|附魔|工坊|木工|缝纫/.test(t)) return TYPE_COLORS['工艺'];
            return null;
        }
        // 流派识别：从区块名/文本推断七大魔法流派（元素/符文/塑能/死灵/召唤/圣光/暗能）+ 元素子类，
        // 用于施法结算按流派差异化染色与专属特效
        function detectElement(text) {
            var t = text || '';
            if (/符文/.test(t)) return 'rune';
            if (/塑能/.test(t)) return 'kinesis';
            if (/死灵|尸术|灵术|亡灵/.test(t)) return 'necro';
            if (/召唤/.test(t)) return 'summon';
            if (/暗能|暗影|虚空/.test(t)) return 'void';
            if (/神术|圣光|信仰|光系/.test(t)) return 'holy';
            if (/火/.test(t)) return 'fire';
            if (/冰/.test(t)) return 'ice';
            if (/水/.test(t)) return 'water';
            if (/风/.test(t)) return 'wind';
            if (/雷/.test(t)) return 'thunder';
            if (/土|岩/.test(t)) return 'earth';
            if (/魔法|术/.test(t)) return 'arcane';
            return null;
        }
        function getPhaseMeta(name) {
            if (isApocalypse) {
                if (/符文/.test(name)) return { c: '#3a7a5a', i: '✳️' };
                if (/塑能/.test(name)) return { c: '#6a5aa8', i: '✹' };
                if (/死灵|尸术|灵术/.test(name)) return { c: '#6a4a6a', i: '💀' };
                if (/召唤/.test(name)) return { c: '#5a6aa8', i: '✶' };
                if (/暗能|暗影|虚空/.test(name)) return { c: '#4a3a4a', i: '🌑' };
                if (/神术|圣光|信仰/.test(name)) return { c: '#9a8a2a', i: '☀' };
                if (/魔法|术/.test(name)) return { c: '#7a5ad0', i: '✧' };
