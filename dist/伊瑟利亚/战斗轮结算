                if (/升级/.test(name)) return { c: '#4ae07a', i: '⬆' };
                // 生产体系（锻造/炼金/工艺）
                if (/锻造|打造|熔炼|铁匠|淬火|铸/.test(name)) return { c: '#b0602a', i: '🔨' };
                if (/炼金|药剂|蒸馏|调配/.test(name)) return { c: '#4a8a5a', i: '⚗️' };
                if (/生产|制作|工艺|附魔|工坊/.test(name)) return { c: '#8a6a3a', i: '🛠' };
                return { c: '#7a4a6a', i: '⚄' };
            }
            if (/符文/.test(name)) return { c: '#3a5a4a', i: '✳️' };
            if (/塑能/.test(name)) return { c: '#4a3a6a', i: '✹' };
            if (/死灵|尸术|灵术/.test(name)) return { c: '#5a3a4a', i: '💀' };
            if (/召唤/.test(name)) return { c: '#4a3a6a', i: '✶' };
            if (/暗能|暗影|虚空/.test(name)) return { c: '#3a2a3a', i: '🌑' };
            if (/神术|圣光|信仰/.test(name)) return { c: '#b8892a', i: '☀' };
            if (/魔法|术/.test(name)) return { c: '#2a4a8a', i: '✧' };
            if (/战技/.test(name)) return { c: '#a06020', i: '⚒' };
            if (/攻击|武技/.test(name)) return { c: '#9a3b2a', i: '⚔' };
            if (/升级/.test(name)) return { c: '#d4af37', i: '⬆' };
            // 生产体系（锻造/炼金/工艺）
            if (/锻造|打造|熔炼|铁匠|淬火|铸/.test(name)) return { c: '#8a4a1a', i: '🔨' };
            if (/炼金|药剂|蒸馏|调配/.test(name)) return { c: '#2f6a4a', i: '⚗️' };
            if (/生产|制作|工艺|附魔|工坊/.test(name)) return { c: '#7a5a2a', i: '🛠' };
            return { c: '#a07828', i: '⚄' };
        }
        // 位阶徽章：从 MVU 变量读角色等阶（主角经 persona 名匹配 / 同伴直接查表）
        function getActorRank(name) {
            try {
                if (!name) return null;
                var stat = null;
                if (typeof Mvu !== 'undefined' && Mvu.getMvuData) {
                    stat = (Mvu.getMvuData({ type: 'message', message_id: 'latest' }) || {}).stat_data;
                }
                if (!stat) return null;
                var n = String(name).trim();
                // 主角：经当前 persona 名匹配
                var heroName = null;
                try { if (typeof getCurrentPersonaName === 'function') heroName = getCurrentPersonaName(); } catch (e) {}
                if (heroName && n === String(heroName).trim()) {
                    var hr = stat.主角 && stat.主角.等阶;
                    return hr ? String(hr) : null;
                }
                // 同伴：直接查表
                if (stat.同伴 && stat.同伴[n]) {
                    var cr = stat.同伴[n].等阶;
                    return cr ? String(cr) : null;
                }
                return null;
            } catch (e) { return null; }
        }
        function rankBadgeHtml(rank) {
            var r = String(rank || '').trim();
            if (!r) return '';
            return '<span class="rank-badge rank-' + r + '">◈ ' + r + '</span> ';
        }
        // 卷首题记：从酒馆变量读 世界.日期 / 世界.时间 / 世界.当前地点（回退当前位置）
        function buildHeadSub() {
            try {
                var stat = null;
                if (typeof Mvu !== 'undefined' && Mvu.getMvuData) {
                    stat = (Mvu.getMvuData({ type: 'message', message_id: 'latest' }) || {}).stat_data;
                }
                var w = (stat && stat.世界) || {};
                var parts = [];
                if (w.日期) parts.push(String(w.日期));
                if (w.时间) parts.push(String(w.时间));
                var loc = w.当前地点 || w.当前位置;
                if (loc) parts.push(String(loc));
                return parts.join(' · ') || (isApocalypse ? '终焉纪元 · 莫尔加纳 · 深渊之忆' : '圣光历 · 阿尔比恩王国 · 冒险者公会笔录');
            } catch (e) {
                return isApocalypse ? '终焉纪元 · 莫尔加纳 · 深渊之忆' : '圣光历 · 阿尔比恩王国 · 冒险者公会笔录';
            }
        }
        // 卷首副标题：按「卷首题头」开关决定是否渲染
        function headSubHtml() {
            return SETTINGS.headSub ? '<div class="head-sub">' + buildHeadSub() + '</div>' : '';
        }
        function getTagClass(key, value) {
            var k = (key || '').toLowerCase();
            var v = (value || '').toLowerCase();
            if (/^hp/i.test(k) || /^hp\b/i.test(v)) return 'tag tag-hp';
            if (/^mp/i.test(k) || /^mp\b/i.test(v)) return 'tag tag-mp';
            if (/^sp/i.test(k) || /^sp\b/i.test(v)) return 'tag tag-sp';
            if (/^角色$|^行动者$|^濒死者$|^目标$|^攻方$|^守方$|^施法者$/.test(k)) return 'tag tag-char';
            if (/^掷骰$|^死亡豁免$/.test(k)) return 'tag tag-dice';
            // 经验值相关
            if (/exp|经验值|经验/.test(k) || /^最终获得/.test(k)) return 'tag tag-exp';
            // 升级相关
            if (/^总等级$|^未分配属性点$|^待分配职业等级$|^等级提升$/.test(k)) return 'tag tag-levelup';
            if (/伤害/.test(k)) return 'tag tag-dmg';
            if (/^防御值$|^防御$|^难度dc$/.test(k)) return 'tag tag-def';
            if (/^动作$|^技能$|^检定项目$|^招式$|^附赠动作$/.test(k)) return 'tag tag-skill';
            if (/^资源消耗$|^资源剩余$/.test(k)) return 'tag tag-resource';
            if (/^先攻序列$|^序列$|^回合/.test(k)) return 'tag tag-round';
            if (/^环境$/.test(k)) return 'tag tag-env';
            if (/^状态$|^状态施加$|^状态变更$|^附加状态$|^累计状态$|^状态保留$/.test(k)) return 'tag tag-status';
            if (/^类型$/.test(k)) return 'tag tag-type';
            if (/^\s*\d+\s*(?:->|→)\s*\d+\s*$/.test(v)) {
                var nums = v.match(/(\d+)[\s]*(?:→|->)[\s]*(\d+)/);
                if (nums && nums.length >= 3) {
                    return parseInt(nums[2]) < parseInt(nums[1]) ? 'tag tag-change-down' : 'tag tag-change-up';
                }
            }
            if (/^判定结果$|^结果$|^最终结果$/.test(k)) {
                if (/大成功|暴击|自然20|胜利/.test(v)) return 'tag tag-crit';
                if (/大失败|自然1|失败|死亡|全灭/.test(v)) return 'tag tag-fail';
                if (/未命中|未中|失手|落空/.test(v)) return 'tag tag-general';
                if (/成功|命中|稳定|苏醒/.test(v)) return 'tag tag-hit';
            }
            // 生产相关（锻造/防具/炼金/工艺）
            if (/^制作者$|^工匠$|^铁匠$|^炼金师$/.test(k)) return 'tag tag-char';
            if (/^材料$|^材料消耗$|^配方$|^原料$|^素材$|^图纸$/.test(k)) return 'tag tag-craft-mat';
            if (/^成品$|^产出$|^产量$/.test(k)) return 'tag tag-craft-out';
            if (/^品质$/.test(k)) {
                if (/史诗|传说|神话|唯一/.test(v)) return 'tag tag-crit';
                if (/精良|稀有/.test(v)) return 'tag tag-craft-out';
                return 'tag tag-craft-mat';
            }
            if (/^工序$|^步骤$|^耗时$|^工时$|^工坊$|^工具$|^火候$|^锻打$|^淬火$|^熔炼$/.test(k)) return 'tag tag-craft-step';
            return 'tag tag-general';
        }
        function detectRowType(text) {
            if (!SETTINGS.critHighlight) return ''; // 关闭开关时不做暴击/大失败/升级高亮
            if (/资源剩余/.test(text)) return 'resource-row';
            if (/大成功|暴击|自然20|胜利/.test(text)) return 'crit-row';
            if (/大失败|自然1/.test(text)) return 'fail-row';
            if (/等级提升|未分配属性点|待分配职业等级/.test(text)) return 'upgrade-row';
            return '';
        }
        // 行图标：只按「键名」与「判定结果值」判断，避免效果/备注文案里的"动作/技能"字样误触发 ⚔
        function rowIconFromPairs(pairs) {
            var keys = [], jud = null, typeVal = null;
            pairs.forEach(function(p) {
                var i = p.indexOf(':');
                if (i === -1) return;
                var k = p.substring(0, i).trim();
                keys.push(k);
                if (/^判定结果$|^结果$|^最终结果$/.test(k)) jud = p.substring(i + 1).trim();
                if (/^类型$/.test(k)) typeVal = p.substring(i + 1).trim();
            });
            function has(pat) { for (var x = 0; x < keys.length; x++) { if (pat.test(keys[x])) return true; } return false; }
            if (has(/^(总等级|未分配属性点|待分配职业等级|等级提升)$/)) return '⬆';
            if (jud && /大成功|暴击|自然20|胜利/.test(jud)) return '✦';
            if (jud && /大失败|自然1/.test(jud)) return '☠';
            // 按「类型」字段着色图标（武技⚔ / 战技⚒ / 魔法✧ / 神术☀ / 元素）
            var tm = (SETTINGS.flowStyle && typeVal) ? getTypeMeta(typeVal) : null;
            if (tm) return tm.i;
            if (has(/^(攻方|守方|动作|技能|招式|附赠动作)$/)) return '⚔';
            if (has(/^(施法者|法术|魔法)$/)) return '✧';
            if (has(/^(检定项目|掷骰|死亡豁免)$/)) return '⚄';
            return '';
        }
        // 资源条：把 "45/45" 渲染成按比例填充的色条
        function resBar(key, value, cls) {
            var m = value.match(/^(\d+)\s*\/\s*(\d+)$/);
            if (!m) return null;
            var cur = parseInt(m[1], 10), max = parseInt(m[2], 10);
            var pct = max > 0 ? Math.min(100, Math.round(cur / max * 100)) : 0;
            return '<span class="kv"><span class="key">' + key + '</span><span class="tag ' + cls + ' res-tag"><i class="res-fill" style="width:' + pct + '%"></i><span class="res-text">' + value + '</span></span></span> ';
        }
        // 角色状态解析：把「名字 HP x/y MP x/y SP x/y ...」渲染为一个灰色小框（名字 + 各资源数值）
        // 例：行人 HP 23/23 MP 12/23 / 巨型穴居鼠A/B/C HP 8/8
        // 兼容紧凑格式（名字与资源、资源与资源之间可有/无空格，尾部可带 (xN) 备注）：
        //   行人HP 23/23MP 6/23SP 0/0 / 穴居鼠AHP 15/15 / 后方鼠群 HP 15/15 (x4)
        function charStatusHtml(text) {
            if (!SETTINGS.charBox) return null; // 关闭开关时回退普通文本/标签渲染
            var s = String(text || '').trim();
            if (!s) return null;
            // 提取全部资源块
            var res = s.match(/(?:HP|MP|SP)\s*\d+\s*\/\s*\d+/ig);
            if (!res || res.length === 0) return null;
            // 名字 = 去掉资源块后的剩余文本；尾部 (xN) 备注单独保留
            var name = s.replace(/(?:HP|MP|SP)\s*\d+\s*\/\s*\d+/ig, '').trim();
            var note = '';
            var nm = name.match(/^(.*?)\s*(\([^)]*\))\s*$/);
            if (nm) { name = nm[1]; note = nm[2]; }
            if (!name) return null;
            var html = '<span class="char-box"><span class="char-name">' + name + '</span>';
            res.forEach(function(seg) {
                var rm = seg.match(/^(HP|MP|SP)\s*(\d+)\s*\/\s*(\d+)$/i);
                if (!rm) return;
                var cls = rm[1].toLowerCase() === 'hp' ? 'hp' : rm[1].toLowerCase() === 'mp' ? 'mp' : 'sp';
                html += '<span class="res-mini ' + cls + '">' + rm[1].toUpperCase() + ' ' + rm[2] + '/' + rm[3] + '</span>';
            });
            if (note) html += '<span class="char-note">' + note + '</span>';
            html += '</span>';
            return html;
        }
        // 角色群状态解析：「队伍状态/敌人状态/资源剩余: 名字 HP x/y | MP x/y | SP x/y | 名字2 ...」
        // 把每个角色的 HP/MP/SP 归入同一个灰框（兼容协议一行全员格式）
        function groupStatusHtml(text) {
            if (!SETTINGS.groupStatus || !SETTINGS.charBox) return null;
            var m = String(text || '').match(/^(队伍状态|敌人状态|队伍|敌人|资源剩余)\s*[:：]\s*([\s\S]+)$/);
            if (!m) return null;
            var body = m[2];
            var tokens = body.split(/\s*\|\s*/).map(function(t) { return t.trim(); }).filter(Boolean);
            var groups = [];
            tokens.forEach(function(tok) {
                if (/^(HP|MP|SP)\s*\d+\s*\/\s*\d+$/i.test(tok)) {
                    if (!groups.length) groups.push({ name: '', res: [] });
                    groups[groups.length - 1].res.push(tok);
                } else {
                    groups.push({ name: tok, res: [] });
                }
            });
            var html = '';
            groups.forEach(function(g) {
                if (!g.name) return;
                var seg = g.res.length ? (g.name + ' ' + g.res.join(' ')).trim() : g.name;
                var c = charStatusHtml(seg);
                if (c) html += c + ' ';
            });
            return html || null;
        }
        function parseAndRender(rawText) {
            var contentDiv = document.getElementById('battleContent');
            if (!rawText || rawText.trim() === '') {
                contentDiv.innerHTML = '<div style="text-align:center;color:' + (isApocalypse ? '#8a5a6a' : '#a0522d') + ';font-weight:600;letter-spacing:2px;">' + (isApocalypse ? '※ 深渊之中空无一物 ※' : '※ 羊皮卷上未记载任何信息 ※') + '</div>';
                return;
            }
            rawText = rawText.replace(/<\/?(战斗结算|检定结算|升级结算|生产结算)>/g, '');
              // ☆ 咏唱特效：咏唱中/咏唱完成待释放/前摇 相关值渲染为金色脉动光晕
              rawText = rawText.replace(/咏唱(?:中|完成待释放|前摇|状态)[：:]\s*[^|\n]{0,40}/g, function(seg){ return '<span class="cast-glow">' + seg + '</span>'; });
            var lines = rawText.split(/\n/);
