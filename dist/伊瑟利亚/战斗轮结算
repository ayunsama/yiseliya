        .phase-block.elem-necro { --phase:#5a3a4a; --wash:linear-gradient(135deg, rgba(90,58,74,.10), rgba(90,58,74,.03)); --edge:rgba(90,58,74,.32); --fx:radial-gradient(ellipse at 30% 65%, rgba(90,58,74,.14), transparent 60%), radial-gradient(ellipse at 72% 28%, rgba(90,58,74,.10), transparent 55%); }
        .phase-block.elem-summon { --phase:#4a3a6a; --wash:linear-gradient(135deg, rgba(74,58,106,.10), rgba(74,58,106,.03)); --edge:rgba(74,58,106,.32); --fx:radial-gradient(circle at 50% 45%, transparent 34%, rgba(74,58,106,.12) 36%, transparent 40%, rgba(74,58,106,.10) 42%, transparent 48%); }
        .phase-block.elem-holy { --phase:#8a6a2a; --wash:linear-gradient(135deg, rgba(138,106,42,.12), rgba(138,106,42,.04)); --edge:rgba(138,106,42,.34); --fx:radial-gradient(ellipse at 50% 0%, rgba(138,106,42,.16), transparent 60%); }
        .phase-block.elem-void { --phase:#3a2a3a; --wash:linear-gradient(135deg, rgba(58,42,58,.10), rgba(58,42,58,.03)); --edge:rgba(58,42,58,.34); --fx:linear-gradient(180deg, transparent, rgba(58,42,58,.16) 92%); }
        .phase-block.elem-arcane { --phase:#3a4a6a; --wash:linear-gradient(135deg, rgba(58,74,106,.10), rgba(58,74,106,.03)); --edge:rgba(58,74,106,.32); --fx:radial-gradient(rgba(58,74,106,.12) 1px, transparent 1.6px) 0 0/18px 18px; }
        .phase-block[class*="elem-"] { border: 1px solid var(--edge, rgba(160,120,64,.28)); border-left: 2px solid var(--phase); background: var(--fx, none), var(--wash, linear-gradient(135deg, rgba(232,214,178,.32), rgba(232,214,178,.30))); box-shadow: inset 0 1px 6px rgba(120,80,30,.06); }
        .phase-block[class*="elem-"] .phase-title { background: var(--wash); border-color: var(--phase); color: #4a3218; }
        .phase-block[class*="elem-"] .phase-icon { color: var(--phase); text-shadow: none; }
        /* 顶部流派角标 */
        .phase-block.elem-fire::after { content: "🔥"; } .phase-block.elem-water::after { content: "💧"; }
        .phase-block.elem-wind::after { content: "🌪️"; } .phase-block.elem-thunder::after { content: "⚡"; }
        .phase-block.elem-ice::after { content: "❄️"; } .phase-block.elem-earth::after { content: "⛰️"; }
        .phase-block.elem-rune::after { content: "✳️"; } .phase-block.elem-kinesis::after { content: "✹"; }
        .phase-block.elem-necro::after { content: "💀"; } .phase-block.elem-summon::after { content: "✶"; }
        .phase-block.elem-holy::after { content: "☀"; } .phase-block.elem-void::after { content: "🌑"; }
        .phase-block.elem-arcane::after { content: "✧"; }
        .phase-block[class*="elem-"]::after { position: absolute; right: 6px; top: -9px; font-size: 15px; z-index: 2; opacity: .6; filter: none; }
        /* 行级流派染色：数据行含「类型」字段时，底色与左边框随流派微变 */
        .data-row.elem-fire { background: linear-gradient(90deg, rgba(122,74,58,.07), transparent); border-left-color: #7a4a3a; }
        .data-row.elem-water { background: linear-gradient(90deg, rgba(58,90,122,.07), transparent); border-left-color: #3a5a7a; }
        .data-row.elem-wind { background: linear-gradient(90deg, rgba(58,106,90,.07), transparent); border-left-color: #3a6a5a; }
        .data-row.elem-earth { background: linear-gradient(90deg, rgba(106,90,58,.07), transparent); border-left-color: #6a5a3a; }
        .data-row.elem-thunder { background: linear-gradient(90deg, rgba(122,106,42,.07), transparent); border-left-color: #7a6a2a; }
        .data-row.elem-ice { background: linear-gradient(90deg, rgba(74,106,122,.07), transparent); border-left-color: #4a6a7a; }
        .data-row.elem-rune { background: linear-gradient(90deg, rgba(58,90,74,.07), transparent); border-left-color: #3a5a4a; }
        .data-row.elem-kinesis { background: linear-gradient(90deg, rgba(74,58,106,.07), transparent); border-left-color: #4a3a6a; }
        .data-row.elem-necro { background: linear-gradient(90deg, rgba(90,58,74,.07), transparent); border-left-color: #5a3a4a; }
        .data-row.elem-summon { background: linear-gradient(90deg, rgba(74,58,106,.07), transparent); border-left-color: #4a3a6a; }
        .data-row.elem-holy { background: linear-gradient(90deg, rgba(138,106,42,.08), transparent); border-left-color: #8a6a2a; }
        .data-row.elem-void { background: linear-gradient(90deg, rgba(58,42,58,.07), transparent); border-left-color: #3a2a3a; }
        .data-row.elem-arcane { background: linear-gradient(90deg, rgba(58,74,106,.07), transparent); border-left-color: #3a4a6a; }

        /* ===== 数据行 ===== */
        .data-row { display: flex; flex-wrap: wrap; align-items: center; padding: 5px 0 5px 10px; margin: 3px 0; gap: 5px 10px; border-left: 2px solid rgba(160,120,64,.25); border-radius: 0 3px 3px 0; transition: border-left-color .2s, background .2s; }
        .data-row:hover { background: rgba(255,248,225,.6); border-left-color: #d4af37; }
        .row-icon { color: #a07828; font-size: .85em; margin-right: 2px; opacity: .9; }
        .data-row.crit-row { background: linear-gradient(90deg, rgba(212,175,55,.22), rgba(255,248,200,.06)); border-left-color: #d4af37; }
        .data-row.fail-row { background: linear-gradient(90deg, rgba(154,31,31,.10), transparent); border-left-color: #9a1f1f; }
        .data-row.upgrade-row { background: linear-gradient(90deg, rgba(212,175,55,.16), rgba(212,175,55,.03)); border-left-color: #d4af37; }
        .data-row.resource-row { background: rgba(245,240,220,.55); border-left-color: #8b7330; margin-top: 6px; }
        .data-row.crit-row .row-icon { color: #d4af37; }
        .data-row.fail-row .row-icon { color: #8a1f1f; }
        .data-row.upgrade-row .row-icon { color: #d4af37; }

        /* ===== 键值（长文本可折行） ===== */
        .kv { display: inline-flex; align-items: flex-start; gap: 4px; max-width: 100%; flex-wrap: wrap; word-break: break-word; overflow-wrap: anywhere; }
        .key { font-weight: 700; color: #3a2718; font-size: .87em; letter-spacing: .5px; flex-shrink: 0; }
        .key::after { content: ":"; margin-left: 1px; margin-right: 4px; color: #7a5020; }

        /* ===== 标签（水彩化 + 双档金） ===== */
        .tag { display: inline-block; padding: 2px 9px; border-radius: 3px; font-weight: 700; font-family: "Noto Serif SC", "华文中宋", serif; font-size: 0.9em; border: 1px solid; line-height: 1.5; letter-spacing: 0.3px; margin: 0 2px; max-width: 100%; word-break: break-word; overflow-wrap: anywhere; }
        .tag-craft-mat { background: linear-gradient(135deg, rgba(106,90,42,.16), rgba(106,90,42,.05)); border-color: #6a5a2a; color: #4a3a14; }
        .tag-craft-step { background: linear-gradient(135deg, rgba(122,74,42,.15), rgba(122,74,42,.05)); border-color: #7a4a2a; color: #4a2a10; }
        .tag-craft-out { background: linear-gradient(135deg, rgba(42,106,74,.15), rgba(42,106,74,.05)); border-color: #2a6a4a; color: #0e3a20; }
        .tag-hp { background: linear-gradient(180deg, rgba(154,31,31,.16), rgba(154,31,31,.05)); border-color: #9a1f1f; color: #7a1414; }
        .tag-mp { background: linear-gradient(180deg, rgba(31,58,122,.16), rgba(31,58,122,.05)); border-color: #1f3a7a; color: #0e2050; }
        .tag-sp { background: linear-gradient(180deg, rgba(31,106,58,.16), rgba(31,106,58,.05)); border-color: #1f6a3a; color: #0e3a20; }
        .tag-char { background: linear-gradient(135deg, #e4d8c6, #d6c6b2); border-color: #5a4030; color: #241208; box-shadow: inset 0 1px 3px rgba(80,50,30,.18); }
        .tag-crit { background: linear-gradient(135deg, #fff3c0, #f7df86); border-color: #d4af37; color: #4a2f00; text-shadow: 0 1px 0 rgba(255,255,255,.4); animation: goldGlow 1.5s ease-in-out infinite alternate; }
        @keyframes goldGlow { from { box-shadow: 0 0 4px rgba(212,175,55,.35); } to { box-shadow: 0 0 12px rgba(212,175,55,.7); } }
        .tag-fail { background: linear-gradient(135deg, #e3c0bc, #d4a09a); border-color: #8a1f1f; color: #5a0f0f; }
        .tag-hit { background: linear-gradient(135deg, #d0e4cc, #bad6b4); border-color: #2f7a4f; color: #0e3a22; }
        .tag-dice { background: linear-gradient(135deg, #f8f0e0, #efe2cc); border-color: #7a5a30; color: #2a1a08; box-shadow: inset 0 1px 3px rgba(100,70,30,.2), 0 1px 3px rgba(0,0,0,.12); font-size: 0.95em; padding: 2px 10px; font-weight: 800; }
        .tag-dice::before { content: "⚄ "; font-size: 0.9em; opacity: 0.7; }
        .tag-dmg { background: linear-gradient(135deg, #f8e0c8, #f0d4b0); border-color: #a06020; color: #5a2a00; box-shadow: inset 0 1px 3px rgba(160,96,32,.2); font-weight: 800; }
        .tag-def { background: linear-gradient(135deg, #dfe6ea, #d0d9e0); border-color: #506070; color: #1c2a38; box-shadow: inset 0 1px 3px rgba(50,70,90,.15); }
        .tag-skill { background: linear-gradient(135deg, #d8e4d0, #c4d8b8); border-color: #4a6b3a; color: #1a3a0a; box-shadow: inset 0 1px 3px rgba(60,90,40,.2); }
        .tag-resource { background: linear-gradient(135deg, #ddd8c8, #d0c8b0); border-color: #7a6a40; color: #3a2810; box-shadow: inset 0 1px 3px rgba(100,80,40,.2); }
        .tag-change-down { background: linear-gradient(135deg, #f0d0c0, #e8c0b0); border-color: #8b3a2a; color: #5a1010; }
        .tag-change-down::before { content: "▼ "; font-size: 0.7em; }
        .tag-change-up { background: linear-gradient(135deg, #d0e8d0, #c4dcc4); border-color: #3a6b3a; color: #0a3a0a; }
        .tag-change-up::before { content: "▲ "; font-size: 0.7em; }
        .tag-general { background: linear-gradient(135deg, #f0e8d8, #e8dfc8); border-color: #9a8060; color: #3a2a18; box-shadow: inset 0 1px 2px rgba(120,100,70,.1); }
        .tag-status { background: linear-gradient(135deg, #dcd8c8, #d4ceb8); border-color: #6a5a3a; color: #3a2a10; box-shadow: inset 0 1px 3px rgba(80,60,30,.15); font-style: italic; }
        .tag-env { background: linear-gradient(135deg, #d0dce0, #c4d0d8); border-color: #3a5a5a; color: #0a2a2a; box-shadow: inset 0 1px 3px rgba(40,70,70,.15); }
        .tag-round { background: linear-gradient(135deg, #e4dcd0, #d8d0c4); border-color: #6a5a40; color: #3a2a18; box-shadow: inset 0 1px 2px rgba(80,60,40,.15); }
        .tag-exp { background: linear-gradient(180deg, rgba(31,106,58,.16), rgba(31,106,58,.05)); border-color: #1f6a3a; color: #0e3a20; font-weight: 800; }
        .tag-levelup { background: linear-gradient(135deg, #f4e8c0, #ecd79e); border: 1px solid #d4af37; color: #4a2f00; animation: levelGlow 2s ease-in-out infinite alternate; }
        @keyframes levelGlow { from { box-shadow: 0 0 4px rgba(212,175,55,.25); } to { box-shadow: 0 0 10px rgba(212,175,55,.5); } }
        .tag-type { background: linear-gradient(135deg, #e0d8c4, #d8cdb8); border-color: #7a6a40; color: #3a2810; box-shadow: inset 0 1px 2px rgba(100,80,50,.15); }
        .type-tag { font-weight: 800; }
        /* 资源条 */
        .res-tag { position: relative; overflow: hidden; padding: 0; }
        .res-fill { position: absolute; left: 0; top: 0; bottom: 0; }
        .res-text { position: relative; display: inline-block; padding: 2px 10px; z-index: 1; }
        .res-tag.tag-hp .res-fill { background: rgba(154,31,31,.30); }
        .res-tag.tag-mp .res-fill { background: rgba(31,58,122,.28); }
        .res-tag.tag-sp .res-fill { background: rgba(31,106,58,.28); }
        /* ===== 角色状态盒：每个角色一个小灰框，内含名字 + HP/MP/SP 数值 ===== */
        .char-box { display: inline-block; vertical-align: middle; padding: 1px 7px; margin: 1px 3px 1px 0; border: 1px solid #5a4030; border-radius: 3px; background: linear-gradient(135deg, #e4d8c6, #d6c6b2); color: #241208; box-shadow: inset 0 1px 2px rgba(80,50,30,.14); max-width: 100%; font-size: .86em; line-height: 1.55; }
        .char-box .char-name { font-weight: 700; margin-right: 4px; white-space: nowrap; }
        .char-box .res-mini { display: inline-block; font-weight: 700; font-size: .92em; padding: 0 3px; margin: 0 1px; border-radius: 2px; background: rgba(255,248,225,.5); }
        .char-box .res-mini.hp { color: #8a1a1a; }
        .char-box .res-mini.mp { color: #123a8a; }
        .char-box .res-mini.sp { color: #12602a; }
        .char-box .char-note { display: inline-block; font-size: .82em; color: #7a5a30; margin-left: 3px; opacity: .85; }
        .val-text { color: #3a2718; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; }

        /* ===== 叙事 + 首字红 ===== */
        .narrative { margin: 8px 0; padding: 8px 14px; font-style: italic; font-weight: 500; color: #4a3018; border-left: 3px solid #c4a050; background: linear-gradient(90deg, rgba(255,248,225,.5), transparent); border-radius: 0 4px 4px 0; line-height: 1.9; }
        .exp-gain { color: #7a5a0a; font-weight: 800; }

        /* ===== 落款 ===== */
        .scroll-footer { margin-top: 22px; padding-top: 10px; text-align: center; color: #8a6a3a; font-size: .85em; letter-spacing: 2px; border-top: 1px dashed rgba(160,120,64,.4); }
        .foot-orn { margin: 0 8px; color: #a07828; }
        .foot-seal { display: inline-block; margin-left: 10px; width: 22px; height: 22px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #b04030, #7a1a10 75%); color: #f2d8a0; font-size: 9px; line-height: 22px; text-align: center; box-shadow: inset 0 1px 3px rgba(255,255,255,.3), 0 1px 3px rgba(0,0,0,.35); }

        /* ===== 事件结算：分隔线 / 分组头 / 标签行 / 经验值更新行 =====
         * 层级原则：标签行/分组头是低调的小标题，经验值数据行才是重点 */
        .divider { height: 1px; margin: 10px auto; width: 70%; background: linear-gradient(90deg, transparent, #c4a050, transparent); border: none; }
        .sub-head { margin: 8px 0 2px; padding: 2px 10px; font-size: .85em; font-weight: 700; color: #5a3a08; background: linear-gradient(90deg, rgba(180,150,60,.10), transparent); border-left: 2px solid #c4a050; letter-spacing: 1px; }
        .label-row { margin: 12px 0 3px; font-size: .82em; font-weight: 700; color: #8a6a3a; letter-spacing: 2px; border-bottom: 1px dashed rgba(160,120,64,.35); padding-bottom: 2px; }
        .data-row.exp-update-row { background: linear-gradient(90deg, rgba(212,175,55,.18), rgba(212,175,55,.04)); border-left-color: #d4af37; padding: 6px 0 6px 10px; }
        .data-row.exp-update-row .row-icon { color: #d4af37; }
        .data-row.exp-update-row .tag { font-size: 0.93em; }
        .data-row.exp-update-row .tag-exp { font-size: 0.96em; }

        /* ===== 响应式 ===== */
        @media screen and (max-width: 480px) {
            .scroll-frame { padding: 14px 0 18px; }
            .scroll { padding: 34px 16px 40px; }
            .content { font-size: 0.85em; line-height: 1.7; }
            .data-row { padding: 4px 0 4px 8px; gap: 4px 6px; }
            .key { font-size: 0.82em; }
            .tag { padding: 2px 6px; font-size: 0.82em; }
            .head-title { font-size: 1.25em; letter-spacing: 6px; }
            .head-sub { font-size: 0.72em; }
            .phase-block { padding: 6px 10px 10px; }
            .phase-title { padding: 3px 12px; font-size: 0.88em; letter-spacing: 2px; }
            .roller { height: 11px; }
            .narrative { padding: 6px 10px; font-size: 0.88em; line-height: 1.7; }
        }
        @media screen and (max-width: 360px) {
            .scroll { padding: 28px 12px 34px; }
            .content { font-size: 0.8em; }
            .data-row { padding: 3px 0 3px 6px; gap: 3px 4px; }
            .tag { padding: 1px 5px; font-size: 0.78em; }
            .phase-title { padding: 2px 10px; font-size: 0.82em; letter-spacing: 1px; }
        }

        /* 腐雾/灰烬元素：仅暗黑风下显示 */
        .fog, .ash { display: none; }

        /* ============================================================
           终焉纪元 · 暗黑风皮肤（body.apocalypse 时生效）
           背景深渊黑紫 + 腐雾灰烬 + 血红/暗紫/腐金/邪绿体系色
        ============================================================ */
        body.apocalypse { background: transparent; }
        body.apocalypse .scroll {
            padding: 40px 32px 46px;
            background:
                radial-gradient(ellipse at 50% 0%, rgba(90,20,60,.22), transparent 58%),
                radial-gradient(ellipse at 82% 100%, rgba(18,90,50,.16), transparent 52%),
                repeating-linear-gradient(0deg, rgba(255,255,255,.012) 0 2px, transparent 2px 26px),
                linear-gradient(180deg, #130b18, #0a0710);
            color: #cbb8c4; border: 1px solid #3a2030; border-top: 3px solid #4a1420; border-bottom: 3px solid #4a1420;
            box-shadow: 0 0 44px rgba(120,20,60,.22), inset 0 0 60px rgba(0,0,0,.62);
        }
        body.apocalypse .stain-1 { width: 210px; height: 210px; right: -44px; top: -36px; background: radial-gradient(circle, rgba(150,30,70,.16), transparent 66%); }
        body.apocalypse .stain-2 { width: 170px; height: 170px; left: -40px; bottom: 4px; background: radial-gradient(circle, rgba(20,90,55,.13), transparent 64%); }
        body.apocalypse .fog, body.apocalypse .ash { display: block; }
        body.apocalypse .fog { position: absolute; inset: 0; pointer-events: none; z-index: 1; background: radial-gradient(ellipse at 22% 30%, rgba(90,20,60,.14), transparent 60%), radial-gradient(ellipse at 78% 66%, rgba(18,70,45,.11), transparent 55%); animation: fogDrift 18s ease-in-out infinite alternate; }
        @keyframes fogDrift { from { opacity: .5; transform: translate(0,0); } to { opacity: .95; transform: translate(-12px, 6px); } }
        body.apocalypse .ash { position: absolute; inset: 0; pointer-events: none; z-index: 1; overflow: hidden; }
        body.apocalypse .ash::before { content: ''; position: absolute; left: 10%; top: 110%; width: 2px; height: 2px; border-radius: 50%; background: #c06080; box-shadow: 90px 0 0 rgba(200,110,140,.7), 210px -20px 0 rgba(150,80,110,.6), 320px -10px 0 rgba(200,110,140,.5), 440px -30px 0 rgba(150,80,110,.6), 560px -5px 0 rgba(200,110,140,.5), 60px -60px 0 rgba(150,80,110,.5), 250px -80px 0 rgba(200,110,140,.45), 400px -100px 0 rgba(150,80,110,.5); animation: ashUp 16s linear infinite; }
        @keyframes ashUp { from { transform: translateY(0); opacity: 0; } 12% { opacity: .85; } 88% { opacity: .5; } to { transform: translateY(-130px); opacity: 0; } }
        body.apocalypse .scroll::before { content: "⚸"; position: absolute; top: 4px; left: 14px; font-size: 15px; color: #8a4a6a; opacity: .6; z-index: 3; }
        body.apocalypse .scroll::after { content: "✦"; position: absolute; right: 24px; bottom: 24px; width: 54px; height: 54px; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #e8a0b0; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #a02030, #3a0810 72%); box-shadow: inset 0 2px 6px rgba(255,255,255,.12), 0 0 16px rgba(160,32,48,.5), 0 2px 5px rgba(0,0,0,.5); z-index: 3; }
        body.apocalypse .roller { background: linear-gradient(180deg, #3a2430, #1c1218 45%, #2a1a24 92%); box-shadow: 0 2px 5px rgba(0,0,0,.6), inset 0 1px 2px rgba(255,255,255,.06); }
        body.apocalypse .roller .cap { background: linear-gradient(90deg, #2e1a24, #150c10 60%, #2e1a24); box-shadow: 0 2px 4px rgba(0,0,0,.5); }
        body.apocalypse .head-orn { color: #7a4a6a; }
        body.apocalypse .head-title { color: #e8d8e0; text-shadow: 0 0 14px rgba(200,40,60,.35), 0 0 34px rgba(120,20,60,.22); }
        body.apocalypse .head-sub { color: #8a7a8a; }
        body.apocalypse .head-rule { background: linear-gradient(90deg, transparent, #6a1a30 20%, #a03040 50%, #6a1a30 80%, transparent); }
        body.apocalypse .phase-block { background: linear-gradient(135deg, var(--wash, rgba(42,16,34,.4)), rgba(20,10,16,.32)); border: 1px solid rgba(90,42,66,.30); border-left: 2px solid var(--phase, #7a4a6a); box-shadow: inset 0 0 22px rgba(0,0,0,.42), 0 0 12px rgba(120,20,60,.12); }
        body.apocalypse .phase-title { background: var(--wash, linear-gradient(135deg, rgba(90,30,50,.32), rgba(40,16,32,.2))); border: 1px solid var(--phase, #7a4a6a); color: #e0d0d8; box-shadow: 0 0 10px rgba(160,40,70,.14), inset 0 0 8px rgba(0,0,0,.35); }
