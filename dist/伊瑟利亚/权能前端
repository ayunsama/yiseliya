    <script>
        // ===== 工具 =====
        function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
        function firstLine(v) { return String(v == null ? '' : v).split(/\r?\n/)[0].trim(); }
        // ===== 职业系别识别（武技/魔法/神术/混合）=====
        // 按"基础职业名"归属；用包含匹配 + 优先级，避免 圣光法师/圣殿骑士/魔剑士 被误判
        var SYS_RULES = [
            // 混合系（优先，避免被误判为武技/魔法）
            ['mixed', ['魔剑士']],
            // 神术系（含"法师/骑士/神官/祭司"的高优先级，避免被武技/"法师"吸走）
            ['divine', ['圣光法师', '神官', '圣殿骑士', '祭司']],
            // 武技系
            ['martial', ['战士', '骑士', '猎人', '斥候', '狂战士', '猎手']],
            // 魔法系
            ['arcane', ['元素法师', '符文师', '塑能师', '死灵法师', '召唤师', '魔导技师', '德鲁伊', '邪术师', '精灵术士', '魔兽使', '魔兽师', '魔兽']]
        ];
        function detectSys(jobRaw) {
            var j = String(jobRaw || '').replace(/[（(【\[].*?[)）】\]]/g, ''); // 去括号后缀（Lv.17 / 火 / 乌尔坎）
            for (var si = 0; si < SYS_RULES.length; si++) {
                var sys = SYS_RULES[si][0], keys = SYS_RULES[si][1];
                for (var ki = 0; ki < keys.length; ki++) {
                    if (j.indexOf(keys[ki]) !== -1) return sys;
                }
            }
            return 'unknown';
        }
        var SYS_LABEL = { martial: '武技系', arcane: '魔法系', divine: '神术系', mixed: '混合系', unknown: '' };
        function detectSysLabel(jobRaw) {
            var s = detectSys(jobRaw);
            return SYS_LABEL[s] || '';
        }

        // ===== 解析 <权能> 文本 → 数组 =====
        // 每条含：权能名/持有者/类型/来源职业/描述/领域效果/发动/代价
        function parsePowers(text) {
            var out = [];
            if (!text) return out;
            var parts = String(text).split(/<权能>\s*/);
            if (parts.length === 1 && String(text).trim()) parts = ['', String(text)];
            for (var pi = 1; pi < parts.length; pi++) {
                var chunk = parts[pi].replace(/<\/权能>\s*/g, '');
                // 提取键值行（键: 值）
                var rec = {};
                chunk.split(/\r?\n/).forEach(function (line) {
                    line = line.trim();
                    if (!line) return;
                    var ci = line.search(/[:：]\s*/);
                    if (ci <= 0) return;
                    var k = line.slice(0, ci).trim();
                    var v = line.slice(ci + 1).trim();
                    if (k && v) rec[k] = v;
                });
                if (rec['权能名'] || rec['描述'] || Object.keys(rec).length) out.push(rec);
            }
            return out;
        }

        // ===== 键值渲染：领域效果/描述多行合并 =====
        function smartVal(v) {
            v = String(v == null ? '' : v).replace(/\r?\n/g, ' ');
            v = esc(v);
            // 数值增量 +N / -N 高亮
            v = v.replace(/(^|[\s（(；;，,、])([+-]\s*\d+)(?=$|[\s）)；;，,、])/g, function (m, pre, num) {
                return pre + '<span class="' + (/^-\s*/.test(num) ? 'down' : 'up') + '">' + esc(num) + '</span>';
            });
            return v;
        }

        // ===== 渲染 =====
        function buildHeadSub() {
            try {
                var stat = null;
                if (typeof Mvu !== 'undefined' && Mvu.getMvuData) stat = (Mvu.getMvuData({ type: 'message', message_id: 'latest' }) || {}).stat_data;
                var w = (stat && stat.世界) || {};
                var parts = [];
                if (w.日期) parts.push(String(w.日期));
                var loc = w.当前地点 || w.当前位置;
                if (loc) parts.push(String(loc));
                return parts.join(' · ') || '传说级 · 自悟之力';
            } catch (e) { return '传说级 · 自悟之力'; }
        }
        function renderPowers(text) {
            var list = parsePowers(text);
            if (!list.length) return '<div class="err-msg">※ 尚未有传说级权能显现 ※</div>';
            var html = '';
            list.forEach(function (rec, idx) {
                var name = rec['权能名'] || rec['名称'] || '无名权能';
                var holder = rec['持有者'] || rec['拥有者'] || '';
                var type = rec['类型'] || rec['权能类型'] || '';
                var isField = /领域/.test(type);
                var job = rec['来源职业'] || rec['职业'] || '';
                var sys = detectSys(job);
                var css = 'power-card ' + (isField ? 'field' : 'personal') + ' sys-' + sys + ' power-pre';
                var delay = Math.min(idx * 0.16, 0.8).toFixed(2) + 's';
                var sysTag = SYS_LABEL[sys] ? '<span class="sys-tag sys-' + sys + '">◈ ' + SYS_LABEL[sys] + '</span>' : '';
                var typeTag = '<span class="type-tag ' + (isField ? 'field' : 'personal') + '">' + (isField ? '◎ 领域型' : '✦ 个体能力') + '</span>';
                html += '<div class="' + css + '" style="animation-delay:' + delay + '"><div class="pc-glow"></div><div class="pc-rim"></div>';
                html += '<div class="card-head"><span class="card-title">' + esc(name) + '</span>' + typeTag + sysTag;
                if (holder) html += '<span class="holder-tag">👤 ' + esc(firstLine(holder)) + '</span>';
                if (job) html += '<span class="job-tag">🎖 ' + esc(firstLine(job)) + '</span>';
                html += '</div><div class="tsplit"></div>';
                // 描述（◈ 小标题条）
                var desc = rec['描述'] || rec['效果'] || '';
                if (desc) html += '<div class="sec-title">描述</div><div class="p-val desc">' + smartVal(desc) + '</div>';
                // 领域效果（领域型专属，◈ 小标题条）
                var fb = rec['领域效果'] || rec['领域'] || '';
                if (fb) html += '<div class="sec-title">领域法则</div><div class="field-box"><div class="fb-body">' + smartVal(fb) + '</div></div>';
                // 发动 / 代价 / 持续时间 / 限制 → ◈ 前缀花纹标题条 + 彩色标注
                var META = {
                    '发动': { cls: 'sec-title costsec pull', body: 'p-val desc costbody pull', tag: '发动' },
                    '代价': { cls: 'sec-title costsec toll', body: 'p-val desc costbody toll', tag: '代价' },
                    '持续时间': { cls: 'sec-title costsec dur', body: 'p-val desc costbody dur', tag: '持续时间' },
                    '限制': { cls: 'sec-title costsec lim', body: 'p-val desc costbody lim', tag: '限制' }
                };
                ['发动', '代价', '持续时间', '限制'].forEach(function (k) {
                    var v = rec[k] || '';
                    if (!v) return;
                    var m = META[k] || { cls: 'sec-title costsec', body: 'p-val desc costbody', tag: k };
                    html += '<div class="' + m.cls + '">' + esc(m.tag) + '</div><div class="' + m.body + '">' + smartVal(v) + '</div>';
                });
                html += '</div>';
            });
            return html;
        }

        // ===== 演示数据 =====
        var DEMO_TEXT = '<权能>\n  权能名: 万象真理·贤者领域\n  持有者: 伊利亚·艾尔诺尔\n  类型: 领域\n  来源职业: 元素法师\n  描述: 以自身为中心展开半径50尺的贤者领域，领域内敌方所有增益状态被强制中止，并暴露法则级弱点，友方施法消耗减半、法术穿透+3。\n  领域效果: 敌方增益失效 / 友方施法减半 / 法则弱点暴露\n  发动: 每场战斗限1次，需消耗全部MP上限的30%\n  代价: 结束后进入魔力枯竭状态，且每次全力展开生理年龄跃升五年\n  持续时间: 5轮\n</权能>\n<权能>\n  权能名: 勇者权能·不屈\n  持有者: 主角\n  类型: 个体能力\n  来源职业: 骑士\n  描述: 每日1次HP归零时自动恢复至50%最大HP，并获得1轮完全无敌与额外完整回合，是濒死之际逆转战局的绝境之力。\n  发动: 自动触发，无需消耗\n  代价: 每次触发后24小时内体力恢复减半\n</权能>\n';

        // ===== 读取注入数据（裸标签 / 实体转义兼容）=====
        function readRawText() {
