    产业:
      type: "{ [产业名: string]: { 类型: string, 位置: string, 描述: string, 结算周期: string, 每期收益: number, 上次结算: string, 状态: string, 购入价: number, 其他说明: string } }"
      check:
        - 【触发】购置/获赠/夺占产业 → insert；状态变更（停业/复业/升级中）→ replace 精确路径
        - 枚举: 类型[房产/田地/商铺/工坊/矿场/股权/船运/其他] 状态[运营中/停业/升级中] 结算周期[每月/每季度]
        - 【脚本托管·收益】产业收益由「产业结算脚本」自动执行：以上次结算为锚、按结算周期补算跨期收益写入 主角.资产与能力.货币 并 insert 追踪记录流水。AI 绝对禁止手动计算或写入产业收益
        - 【脚本托管·勿改】上次结算（格式 圣光历YYYY年M月）为脚本托管字段，AI 绝对禁止修改；留空=尚未结算（首次结算从购置次期起算）
        - 【绝对禁止】remove 产业（防删账）；产业出售/失去 → 状态 改"停业"并在 其他说明 注明，物理删除由玩家在状态栏操作
        - 每期收益 可为负数（净维护费，如每月 -200 铜盾）
      操作示例:
        购置商铺: { "op": "insert", "path": "/产业/梅萨利亚香料铺", "value": { "类型": "商铺", "位置": "卡兰蒂亚·梅萨利亚港", "结算周期": "每季度", "每期收益": 800, "购入价": 12000, "状态": "运营中" } }
        （上次结算 留空 → 结算脚本自动从购置次期起算入账）
        停业: { "op": "replace", "path": "/产业/梅萨利亚香料铺/状态", "value": "停业" }
