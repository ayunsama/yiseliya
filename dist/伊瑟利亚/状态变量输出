<%
var quests = V.主角.任务 || {};
// 已完成/已交付的任务直接清除（不进入上下文）；数据保留，仅输出去重省 token
var activeQuests = Object.entries(quests).filter(([, qd]) => {
  var st = String(qd?.状态 || '');
  return !/(已完成|已结束|完成|成功|已交付|已结清)/.test(st);
});
if (activeQuests.length === 0) { print('    无\n'); }
else {
  for (var [qn, qd] of activeQuests) {
