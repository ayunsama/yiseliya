var legendNames = ['艾莉卡', '莉莉丝', '科里维坦', '伊利亚'];
print('    ' + legendNames.map(n => `${n}: ${legends[n] ? '已觉醒' : '未觉醒'}`).join(' | ') + '\n');
%>
  世界概况: <%= V.世界.世界见闻?.世界概况 || '暂无' %>
  追踪记录（经济/物品/经验流水<%= V.$flags?.追踪记录全量 ? '·全量' : '·最近5条' %>）:
<%
var tlog = V.世界.追踪记录 || {};
var _fullFlag = V.$flags?.追踪记录全量 === true;
var tkeys = Object.keys(tlog).sort().reverse();
var _show = _fullFlag ? tkeys : tkeys.slice(0, 5);
if (_show.length === 0) { print('    暂无\n'); }
else {
  for (var tk of _show) {
    var te = tlog[tk] || {};
    var tl = '    - ' + (te.时间 || tk) + ' [' + (te.类型 || '其他') + ']';
    if (te.金额) tl += ' ' + (te.金额 > 0 ? '+' : '') + te.金额 + (te.类型 === '经验获取' ? 'EXP' : '铜盾');
    if (te.物品) tl += ' ' + te.物品 + (te.数量 ? '×' + te.数量 : '');
    if (te.说明) tl += '（' + te.说明 + '）';
    if (te.余额 != null && te.余额 >= 0) tl += ' → 余额 ' + te.余额 + '铜盾';
    print(tl + '\n');
  }
}
%>
  动态新闻:
<%
var news = V.世界.世界见闻?.动态新闻 || {};
// 仅输出 最近5条 + 屏蔽逾期（是否过期==='是' 不进入上下文；数据保留，输出去重省 token）
var newsKeys = Object.keys(news)
  .filter(k => !(news[k] && String(news[k].是否过期) === '是'))
  .slice(-5);   // Object.keys 按插入顺序（后插入=最新）
if (newsKeys.length === 0) { print('    暂无\n'); }
else {
  for (var nt of newsKeys) {
    var nd = news[nt];
    print(`    - ${nt}${nd?.日期 ? ` (${nd.日期})` : ''}${nd?.重要性 ? ` [重要性:${nd.重要性}]` : ''}\n`);
    if (nd?.内容) print(`      内容: ${nd.内容}\n`);
    if (nd?.相关地点) print(`      相关地点: ${nd.相关地点}\n`);
    if (nd?.相关势力) print(`      相关势力: ${nd.相关势力}\n`);
  }
}
