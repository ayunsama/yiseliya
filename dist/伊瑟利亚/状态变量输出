    print(`    资源: 储备 ${Object.keys(res.储备 || {}).length ? fmtRec(res.储备) : '-'}${res.特殊资源 ? ` | 特殊资源: ${res.特殊资源}` : ''}${Object.keys(res.物产 || {}).length ? ` | 物产: ${fmtRec(res.物产)}` : ''}\n`);
