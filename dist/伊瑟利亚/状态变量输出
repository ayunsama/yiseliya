    print(`    经济: 收入 ${eco.财政收入 ?? 0}/季 | 支出 ${eco.财政支出 ?? 0}/季 | 国库 ${eco.国库 ?? 0}${eco.商业发展 ? ` | 商业: ${eco.商业发展}` : ''}${Object.keys(eco.产业 || {}).length ? ` | 产业: ${fmtRec(eco.产业)}` : ''}\n`);
    const bld = t.建筑 || {};
    const built = bld.已建造 || {};
    if (Object.keys(built).length) {
      print(`    建筑位（种族:${bld.种族 || '人类'}）:\n`);
      for (const [bn, bd] of Object.entries(built)) {
        let bline = `      - ${bn} Lv.${bd.等级 ?? 1}`;
        const bns = bd.加成 || {};
        const bnArr = Object.entries(bns).filter(([k, v]) => v != null && v !== '');
