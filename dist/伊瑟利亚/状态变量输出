    print(`    外交: 关系 ${Object.keys(dip.关系 || {}).length ? fmtRec(dip.关系) : '-'}${Object.keys(dip.盟约 || {}).length ? ` | 盟约: ${Object.keys(dip.盟约).join('、')}` : ''}${Object.keys(dip.敌对 || {}).length ? ` | 敌对: ${Object.keys(dip.敌对).join('、')}` : ''}${Object.keys(dip.贸易协定 || {}).length ? ` | 贸易: ${Object.keys(dip.贸易协定).join('、')}` : ''}\n`);
