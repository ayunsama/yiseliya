    const _fAge = d.出生年月日 ? eraAge(d.出生年月日, V.世界?.日期) : null;
    if (d.出生年月日) line += ` | 年龄: ${_fAge !== null && _fAge !== undefined ? _fAge + '岁' : '（日期未知）'}（出生:${d.出生年月日}）`;
    if (d.资质?.等级 && d.资质.等级 !== '平庸') line += ` | 资质: ${d.资质.等级}`;
    if (d.魔力回路?.品阶 && d.魔力回路.品阶 !== '无回路') line += ` | 回路: ${d.魔力回路.品阶}`;
    if (d.等阶 && d.等阶 !== '普通') line += ` | 位阶: ${d.等阶}`;
    if (d.身份) line += ` | 身份: ${d.身份}`;
    if (d.所在地) line += ` | 所在地: ${d.所在地}`;
    line += ` | 好感度: ${d.好感度 ?? 0}`;
    const _plan = d.培养计划 || {};
    if (_plan.方向) line += ` | 培养中: ${_plan.方向}${_plan.期望职业 ? '（期望职业:' + _plan.期望职业 + '）' : ''}`;
