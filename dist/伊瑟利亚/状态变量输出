  else if (comp.年龄) print(`    年龄: ${comp.年龄}岁\n`);
  print(`    种族: ${comp.种族 || '-'} | 所属势力: ${comp.所属势力 || '-'} | 身份: ${comp.身份 || '-'} | 当前位置: ${comp.当前位置 || '-'}\n`);
  print(`    等阶: ${comp.等阶 || '普通'} | 好感度: ${comp.好感度 ?? 0} | 防御值: ${comp.防御值 ?? 10}\n`);
  if (comp.扉斗方式) print(`    ★ 戫斗方式: ${comp.戫斗方式}（玩家设定：战斗中按此倾向行动；仅玩家可改，禁止改写）\n`);
  print(`    基础属性: 力${_.get(comp, '基础属性.力量', 10)} 敏${_.get(comp, '基础属性.敏捷', 10)} 体${_.get(comp, '基础属性.体质', 10)} 智${_.get(comp, '基础属性.智力', 10)} 感${_.get(comp, '基础属性.感知', 10)} 魅${_.get(comp, '基础属性.魅力', 10)}${_.get(comp, '基础属性.未分配点数', 0) ? `（未分配${_.get(comp, '基础属性.未分配点数', 0)}）` : ''}\n`);
  print(`    基础状态: HP ${_.get(comp, '基础状态.HP.当前', 0)}/${_.get(comp, '基础状态.HP.最大', 0)} | MP ${_.get(comp, '基础状态.MP.当前', 0)}/${_.get(comp, '基础状态.MP.最大', 0)} | SP ${_.get(comp, '基础状态.SP.当前', 0)}/${_.get(comp, '基础状态.SP.最大', 0)}\n`);
  print(`    总等级: ${_.get(comp, '基础状态.总等级', 1)} | 冒险者等级: ${_.get(comp, '基础状态.冒险者等级', 'F')} | 待分配职业等级: ${_.get(comp, '基础状态.待分配职业等级', 0)} | 经验: ${_.get(comp, '基础状态.经验值.当前', 0)}/${_.get(comp, '基础状态.经验值.升级所需', 100)}\n`);
  // ★ 同伴装备栏（含面板效果，AI 可见同伴装备加成）
  var cequip = comp.装备栏 || {};
  var cslots = ['头部','颈部','躯干','腿部','双手'];
  print(`    装备栏:\n`);
  for (var cs of cslots) {
    var ce = cequip[cs];
    if (ce && ce.物品名) {
      var cline = `      ${cs}: ${ce.物品名}${ce.品阶 && ce.品阶 !== '普通' ? ` [${ce.品阶}]` : ''}`;
      var cbp = ce.面板效果;
      if (cbp) {
        var carr = Object.entries(cbp).filter(([k, v]) => v != null && v !== '');
        if (carr.length) cline += `（属性:${carr.map(([k, v]) => `${k}:${v}`).join(', ')}）`;
      }
      var ctc = ce.附加词条 && typeof ce.附加词条 === 'object' ? Object.values(ce.附加词条).filter(v => v).join('；') : '';
      if (ctc) cline += ` 词条:${ctc}`;
      if (ce.特别机制) cline += ` 特别机制:${ce.特别机制}`;
      print(cline + '\n');
    } else {
      print(`      ${cs}: — 空 —\n`);
    }
