<body>
    <div id="rawData" style="display:none;">$1</div>
    <div class="stage">
        <div class="scroll-frame">
            <div class="roller roller-top"><i class="cap c-l"></i><i class="cap c-r"></i></div>
            <div class="scroll">
                <span class="stain stain-1"></span>
                <span class="stain stain-2"></span>
                <div class="content" id="battleContent">
                    <div style="text-align:center; color:#8b6914; font-weight:600; letter-spacing:2px;">─ 展开军情战报中 ─</div>
                </div>
            </div>
            <div class="roller roller-bottom"><i class="cap c-l"></i><i class="cap c-r"></i></div>
        </div>
    </div>
    <script>
        // ===== 战役类型配色（伊瑟利亚军事沙盘：攻城=赭红 / 会战=群青 / 围城=灰蓝 / 突袭=暗红 / 议和=鎏金 / 默认=金棕） =====
        function hexA(hex, a) {
            var n = parseInt(hex.slice(1), 16);
            return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + a + ')';
        }
        function phaseMeta(name) {
            if (/攻城/.test(name)) return { c: '#9a3b2a', i: '⚔' };
            if (/会战|决战/.test(name)) return { c: '#2a4a8a', i: '⚔' };
            if (/围城|围困/.test(name)) return { c: '#5a6a7a', i: '⛨' };
            if (/突围|奇袭|伏击/.test(name)) return { c: '#8a2a1a', i: '⚔' };
            if (/遭遇/.test(name)) return { c: '#a06020', i: '⚔' };
            if (/议和|外交|谈判|休战/.test(name)) return { c: '#b8892a', i: '☮' };
            if (/推演|战局/.test(name)) return { c: '#a07828', i: '✦' };
            if (/结算|结果|终局/.test(name)) return { c: '#d4af37', i: '⚔' };
            return { c: '#a07828', i: '⚔' };
        }
        // 粮草档位样式
        function supplyCls(v) {
            var s = String(v || '');
            if (/充裕/.test(s)) return 'supply-full';
            if (/充足/.test(s)) return 'supply-ok';
            if (/紧缺/.test(s)) return 'supply-low';
            if (/告急|耗尽/.test(s)) return 'supply-empty';
            return 'supply-ok';
        }
        // 键值标签分类（国战版：攻/守方、兵力/士气、粮草、变化、结果等）
        function getTagClass(key, value) {
            var k = (key || '').toLowerCase();
            var v = (value || '').toLowerCase();
            // 数值变化优先（支持小数与「万」单位）：X -> Y
            if (/^\s*[\d.]+\s*万?\s*(?:->|→)\s*[\d.]+\s*万?\s*$/.test(v)) {
                var nums = v.match(/([\d.]+)\s*(万)?\s*(?:→|->)\s*([\d.]+)\s*(万)?/);
                if (nums && nums.length >= 5) {
                    // 带「万」的数值先 ×10000 再比较，避免 1万 vs 9100 误判
                    var chg1 = parseFloat(nums[1]) * (nums[2] ? 10000 : 1);
                    var chg2 = parseFloat(nums[3]) * (nums[4] ? 10000 : 1);
                    return chg2 < chg1 ? 'tag tag-change-down' : 'tag tag-change-up';
                }
            }
            if (/^攻方|^攻军/.test(k)) return 'tag tag-atk';
            if (/^守方|^守军/.test(k)) return 'tag tag-def';
            if (/^主帅|^将领|^指挥官/.test(k)) return 'tag tag-char';
            if (/^粮草|^补给|^后勤/.test(k)) return 'tag tag-supply';
            if (/^兵力|^军力/.test(k)) return 'tag tag-troop';
            if (/^策略判定$|^策略掷骰$|^策略骰$/.test(k)) return 'tag tag-dice';
            if (/^策略伤害$/.test(k)) return 'tag tag-dmg';
            if (/^判定结果$/.test(k)) {
                if (/大成功|暴击|自然20|完胜/.test(v)) return 'tag tag-crit';
                if (/大失败|自然1|惨败|溃败/.test(v)) return 'tag tag-fail';
                if (/失败/.test(v)) return 'tag tag-fail';
                if (/成功/.test(v)) return 'tag tag-hit';
            }
            if (/^结果$|^战果$/.test(k)) {
                if (/破城|溃败|大捷|全歼|征服|胜利/.test(v)) return 'tag tag-crit';
                if (/失守|败北|惨败|覆灭|投降|失败/.test(v)) return 'tag tag-fail';
                if (/守住|成功|击退/.test(v)) return 'tag tag-hit';
                if (/僵持|休战|议和/.test(v)) return 'tag tag-general';
            }
            if (/^转折$|^关键/.test(k)) return 'tag tag-general';
            return 'tag tag-general';
        }
        // 资源条（士气 78/100 之类）
        function resBar(key, value, cls) {
            var m = value.match(/^(\d+)\s*\/\s*(\d+)$/);
            if (!m) return null;
            var cur = parseInt(m[1], 10), max = parseInt(m[2], 10);
            var pct = max > 0 ? Math.min(100, Math.round(cur / max * 100)) : 0;
            var keyHtml = key ? '<span class="key">' + key + '</span>' : '';
            return '<span class="kv">' + keyHtml + '<span class="tag ' + cls + ' res-tag"><i class="res-fill" style="width:' + pct + '%"></i><span class="res-text">' + value + '</span></span></span> ';
        }
        // 势力卡渲染
        function factionCard(side, name, st, cls) {
            var h = '<div class="faction-card ' + cls + '">';
            h += '<div class="faction-head"><span class="faction-side">' + side + '</span><span class="faction-name">' + String(name || '?') + '</span></div>';
            if (st.兵力) h += '<div class="f-stat"><span class="f-k">兵力</span><span class="f-v troop">' + st.兵力 + '</span></div>';
            if (st.士气) {
                var bar = resBar('士气', st.士气, cls === 'atk' ? 'tag tag-atk' : 'tag tag-def');
                if (bar) h += '<div class="f-stat"><span class="f-k">士气</span>' + bar.replace('<span class="key">士气</span>', '') + '</div>';
            }
            if (st.粮草) h += '<div class="f-stat"><span class="f-k">粮草</span><span class="supply ' + supplyCls(st.粮草) + '">' + st.粮草 + '</span></div>';
            if (st.主帅) h += '<div class="f-stat"><span class="f-k">主帅</span><span class="f-v">' + st.主帅 + '</span></div>';
            h += '</div>';
            return h;
        }
        // 战局天平
        function tideHtml(tide) {
            var left = 50;
            if (/攻方占优|攻方优势/.test(tide)) left = 70;
            else if (/守方占优|守方优势/.test(tide)) left = 30;
            var h = '<div class="tide"><div class="tide-track"><div class="tide-fill" style="left:' + left + '%"></div></div>';
            h += '<div class="tide-labels"><span>攻方</span><span>胶着</span><span>守方</span></div>';
            h += '<div class="tide-mark">⚖ 战局：' + tide + '</div></div>';
            return h;
        }
        // 主解析渲染
        function parseAndRender(rawText) {
            var contentDiv = document.getElementById('battleContent');
            if (!rawText || rawText.trim() === '') {
                contentDiv.innerHTML = '<div style="text-align:center;color:#a0522d;font-weight:600;letter-spacing:2px;">※ 军情未达，战报未书 ※</div>';
                return;
            }
            // 按顶层战报块提取：只渲染战报块内容，忽略 AI 输出中的周围正文。
            // ★ 协议标准包裹标签为 <战争结算>...</战争结算>（见世界书 [国战回合协议] 模板），兼容旧写 <国战结算>。
            var warBlocks = rawText.match(/<(战争结算|国战结算)>[\s\S]*?<\/(战争结算|国战结算)>/g);
            if (warBlocks && warBlocks.length) {
                rawText = warBlocks.map(function(b) { return b.replace(/<\/?(战争结算|国战结算|国战|战报)>/g, ''); }).join('\n');
            } else {
                // ★ 无标准包裹（AI 漏闭合标签 / 城战等未用顶层包裹的格式）：绝不整段渲染，
                //   否则会把战报前后的正常叙事正文一起吞进前端（污染）。只截取战报特征区并剔除纯散文行。
                var anchor = rawText.search(/\{国战总览|\{城战结算|\{战争总览|^[^\S\n]*\|[^|]*(战争|攻方|守方|战局)[:：]/m);
                if (anchor === -1) {
                    contentDiv.innerHTML = '<div style="text-align:center;color:#a0522d;font-weight:600;letter-spacing:2px;">※ 未检测到战争战报（需含「{国战总览 / {城战结算」或「| 战争:」数据行）※</div>';
                    return;
                }
                var subLines = rawText.slice(anchor).split(/\n/);
                rawText = subLines.filter(function(l) {
                    var t = l.trim();
                    if (t === '') return true;                 // 空行保留
                    if (/^\{.*\}$/.test(t)) return true;       // 阶段块 {攻城战 - X}
                    if (/^\[.+\]$/.test(t)) return true;       // 小节标题 [战局推演]
                    if (t.indexOf('|') !== -1) return true;    // 数据行（| 键: 值）
                    return false;                              // 纯散文叙事行 → 剔除，防止正文污染
                }).join('\n');
            }
            var lines = rawText.split(/\n/);
            // ===== 预扫描：国战总览（构建军事沙盘） =====
            var meta = { war: '', atk: '', def: '', day: '', atkSt: {}, defSt: {}, tide: '', focus: '', situation: '' };
            var inOverview = false;
            lines.forEach(function(line) {
                var t = line.trim();
                if (/^\{国战总览/.test(t)) { inOverview = true; var dm = t.match(/第\s*(\d+)\s*日/); if (dm) meta.day = dm[1]; return; }
                if (!inOverview) return;
                if (/^\{/.test(t)) { inOverview = false; return; }
                if (t.indexOf('|') === -1) { if (t && !meta.situation) meta.situation = t; return; }
                var clean = t.replace(/^\|\s*/, '').replace(/\s*\|?\s*$/, '');
                var pairs = clean.split(/\s*\|\s*/);
                var first = pairs[0].trim();
                var fi = first.indexOf(':');
                if (fi !== -1) {
                    var fk = first.substring(0, fi).trim();
                    var fv = first.substring(fi + 1).trim();
                    if (fk === '战争') {
                        meta.war = fv;
                        for (var pi = 1; pi < pairs.length; pi++) {
                            var qi = pairs[pi].indexOf(':');
                            if (qi === -1) continue;
                            var qk = pairs[pi].substring(0, qi).trim();
                            var qv = pairs[pi].substring(qi + 1).trim();
                            if (qk === '攻方') meta.atk = qv;
                            else if (qk === '守方') meta.def = qv;
                        }
                        return;
                    }
                    if ((fk === '攻方' || fk === '守方') && /兵力/.test(fv)) {
                        var st = fk === '攻方' ? meta.atkSt : meta.defSt;
                        st.兵力 = fv.replace(/^兵力\s*/, '');
                        // 后续裸项/带冒号项：士气 78/100 / 粮草 充足 / 主帅 X / 兵力 Y
                        for (var pj = 1; pj < pairs.length; pj++) {
                            var seg = pairs[pj].trim();
                            var sm = seg.match(/^(士气|粮草|主帅|兵力)\s*[:：]?\s*(.+)$/);
                            if (!sm) continue;
                            var sk2 = sm[1], sv2 = sm[2].trim();
                            if (sk2 === '士气') st.士气 = sv2;
                            else if (sk2 === '粮草') st.粮草 = sv2;
                            else if (sk2 === '主帅') st.主帅 = sv2;
                            else if (sk2 === '兵力') st.兵力 = sv2;
                        }
                        return;
                    }
                    if (fk === '战局') meta.tide = fv;
                    else if (fk === '焦点') meta.focus = fv;
                    else if (fk === '态势') meta.situation = fv;
                }
            });
            // ===== 渲染 =====
            var html = '';
            // 卷首题头
            html += '<div class="scroll-header"><div class="head-orn">⚔ ─── ✦ ─── ⚔</div><div class="head-title">国战战报</div><div class="head-sub">' + (meta.war ? meta.war : '势力纷争 · 战局纪要') + '</div><div class="head-rule"></div></div>';
            // 军事沙盘
            if (meta.atk || meta.def || meta.tide || meta.situation) {
                html += '<div class="war-band">';
                html += '<div class="war-head"><span class="war-title">⚔ ' + (meta.war || '国战') + '</span>' + (meta.day ? '<span class="war-day">战争第 ' + meta.day + ' 日</span>' : '') + '</div>';
                if (meta.atk || meta.def) {
                    html += '<div class="faction-row">';
                    if (meta.atkSt) html += factionCard('攻方', meta.atk, meta.atkSt, 'atk');
                    html += '<div class="war-vs">VS</div>';
                    if (meta.defSt) html += factionCard('守方', meta.def, meta.defSt, 'def');
                    html += '</div>';
                }
                if (meta.tide) html += tideHtml(meta.tide);
                if (meta.focus) html += '<div class="war-focus">📌 焦点：' + meta.focus + '</div>';
                if (meta.situation) html += '<div class="war-situation">' + meta.situation + '</div>';
                html += '</div>';
            }
            // 主循环：渲染总览之外的行
            var inBlock = false;
            var inOverview = false;
            lines.forEach(function(line) {
                var t = line.trim();
                if (t === '') return;
                if (inOverview) {
                    if (/^\{/.test(t)) inOverview = false;
                    else return; // 跳过总览块内的行（已沙盘化）
                }
                if (/^\{国战总览/.test(t)) { inOverview = true; return; }
                if (/^\{.+\}$/.test(t)) {
                    var name = t.replace(/[{}]/g, '');
                    if (inBlock) html += '</div>';
                    var pm = phaseMeta(name);
                    html += '<div class="phase-block" style="--phase:' + pm.c + ';--wash:linear-gradient(135deg,' + hexA(pm.c, .16) + ',' + hexA(pm.c, .06) + ')">';
                    inBlock = true;
                    html += '<div class="phase-marker"><span class="phase-title"><span class="phase-icon">' + pm.i + '</span>' + name + '<span class="phase-icon">' + pm.i + '</span></span></div>';
                    return;
                }
                if (t.indexOf('|') !== -1) {
                    var clean = t.replace(/^\|\s*/, '').replace(/\s*\|?\s*$/, '');
                    if (!/\|[^|]+:/.test(t)) { html += '<div class="narrative">' + clean + '</div>'; return; }
                    var pairs = clean.split(/\s*\|\s*/);
                    var isTurn = false;
                    // 行图标：策略判定 ⚄ / 策略伤害 💥 / 判定结果 ✦☠
                    var rowIcon = '';
                    var keysList = [];
                    pairs.forEach(function(p) { var ii = p.indexOf(':'); if (ii !== -1) keysList.push(p.substring(0, ii).trim()); });
                    if (keysList.indexOf('策略判定') !== -1) rowIcon = '⚄';
                    else if (keysList.indexOf('策略伤害') !== -1) rowIcon = '💥';
                    else if (keysList.indexOf('判定结果') !== -1) {
                        var jv = '';
                        pairs.forEach(function(p) { var ii = p.indexOf(':'); if (ii !== -1 && p.substring(0, ii).trim() === '判定结果') jv = p.substring(ii + 1).trim(); });
                        if (/大成功|暴击|完胜/.test(jv)) rowIcon = '✦';
                        else if (/大失败|惨败/.test(jv)) rowIcon = '☠';
                    }
                    var rowHtml = '<div class="data-row' + (isTurn ? '' : '') + '">';
                    if (rowIcon) rowHtml += '<span class="row-icon">' + rowIcon + '</span>';
                    pairs.forEach(function(pair) {
                        if (!pair.trim()) return;
                        var idx = pair.indexOf(':');
                        if (idx !== -1) {
                            var key = pair.substring(0, idx).trim();
                            var value = pair.substring(idx + 1).trim();
                            if (!value) value = '---';
                            var cls = getTagClass(key, value);
                            if (/^转折$|^关键/.test(key)) { isTurn = true; }
                            rowHtml += '<span class="kv"><span class="key">' + key + '</span><span class="' + cls + '">' + value + '</span></span> ';
                        } else {
                            var fragment = pair.trim();
                            if (/^\s*[\d.]+\s*万?\s*(?:->|→)\s*[\d.]+\s*万?\s*$/.test(fragment)) {
                                var fn = fragment.match(/([\d.]+)\s*(万)?\s*(?:→|->)\s*([\d.]+)\s*(万)?/);
                                var fchg1 = parseFloat(fn[1]) * (fn[2] ? 10000 : 1);
                                var fchg2 = parseFloat(fn[3]) * (fn[4] ? 10000 : 1);
                                var fcls = fchg2 < fchg1 ? 'tag tag-change-down' : 'tag tag-change-up';
                                rowHtml += '<span class="' + fcls + '">' + fragment + '</span> ';
                            } else if (/→|->/.test(fragment)) {
                                rowHtml += '<span class="tag tag-general">' + fragment + '</span> ';
                            } else if (fragment) {
                                rowHtml += '<span class="kv"><span class="val-text">' + fragment + '</span></span> ';
                            }
                        }
                    });
                    if (isTurn) rowHtml = rowHtml.replace('<div class="data-row', '<div class="data-row turn-row') + '<span class="row-icon" style="float:right;opacity:.6;">✦</span>';
                    rowHtml += '</div>';
                    html += rowHtml;
                    return;
                }
                if (/^-{2,}$/.test(t)) { html += '<div class="divider"></div>'; return; }
                if (/^\[战局推演\]$/.test(t)) { html += '<div class="sub-head">⚔ 战局推演</div>'; return; }
                if (/^\[.+\]$/.test(t)) { html += '<div class="sub-head">' + t.replace(/[\[\]]/g, '') + '</div>'; return; }
                // 推演内容（攻方优势/隐患 | 守方优势/隐患）→ 分栏
                if (/攻方优势|守方优势|攻方隐患|守方隐患/.test(t) && t.indexOf('|') !== -1) {
                    var tc = t.replace(/^\|\s*/, '').replace(/\s*\|?\s*$/, '').split(/\s*\|\s*/);
                    html += '<div class="war-tactics">';
                    tc.forEach(function(seg) {
                        var si = seg.indexOf(':');
                        if (si === -1) return;
                        var sk = seg.substring(0, si).trim();
                        var sv = seg.substring(si + 1).trim();
                        var isAtk = /攻方/.test(sk);
                        html += '<div class="tactic-col ' + (isAtk ? 'atk' : 'def') + '"><div class="tc-title">' + (isAtk ? '⚔ 攻方' : '⛨ 守方') + ' · ' + (/优势/.test(sk) ? '优势' : '隐患') + '</div>' + sv + '</div>';
                    });
                    html += '</div>';
                    return;
                }
                if (/^(结果|影响|战果|损失|态势|焦点|战争|攻方兵力|守方兵力|攻方士气|守方士气)$/.test(t)) { html += '<div class="label-row">' + t + '</div>'; return; }
                html += '<div class="narrative">' + t + '</div>';
            });
            if (inBlock) html += '</div>';
            html += '<div class="scroll-footer"><span class="foot-orn">─ ✦ ─</span><span>战报记 · 军情处</span><span class="foot-orn">─ ✦ ─</span><span class="foot-seal">报</span></div>';
            contentDiv.innerHTML = html;
        }
        // 获取楼层原文：优先 #rawData（$1 占位，测试环境可能已填充）；否则从当前楼层聊天记录读取（酒馆助手标准方式）
        function getRawText() {
            var rawEl = document.getElementById('rawData');
            if (rawEl) {
                var t = rawEl.innerText || rawEl.textContent || '';
                if (t && t.trim() !== '' && t.indexOf('$1') === -1) return t;
            }
            try {
                var mid = getCurrentMessageId();
                var msgs = getChatMessages(mid);
                if (msgs && msgs.length && msgs[0].message) {
                    return msgs[0].message;
                }
            } catch (e) {
                console.warn('⚠ 读取楼层原文失败:', e);
            }
            return '';
        }
        function init() {
            try {
                var raw = getRawText();
                parseAndRender(raw);
            } catch (e) {
                document.getElementById('battleContent').innerHTML = '<div style="color:#8b2222; text-align:center;font-weight:600;">※ 战报损毁，无法解读 ※</div>';
            }
        }
        $(function() { init(); });
    </script>
