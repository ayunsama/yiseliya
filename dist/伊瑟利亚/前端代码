<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>莉耶芙表情对话框 · 妖精绿主题版</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
            background: transparent;
            padding: 10px;
        }

        .liyev-wrapper {
            display: flex;
            align-items: stretch;
            max-width: 720px;
            margin: 5px auto;
            background: linear-gradient(145deg, #f8fdf5 0%, #f0fae8 100%);
            border: 1px solid #c8e0b0;
            border-radius: 18px;
            box-shadow: 0 4px 18px rgba(160, 200, 120, 0.3);
            overflow: hidden;
            animation: fadeInLiyev 0.5s ease-in-out;
            gap: 0;
            transition: box-shadow 0.3s ease;
        }

        .liyev-wrapper:hover {
            box-shadow: 0 6px 28px rgba(130, 180, 90, 0.25);
        }

        @keyframes fadeInLiyev {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ===== 头像区 ===== */
        .liyev-avatar {
            flex-shrink: 0;
            width: 110px;
            min-height: 110px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px 0 12px 14px;
            align-self: center;
            transition: all 0.3s ease;
        }

        .liyev-avatar img {
            display: block;
            width: 100%;
            height: auto;
            max-height: 130px;
            object-fit: contain;
            object-position: center;
            border-radius: 10px;
            transition: transform 0.4s ease, opacity 0.5s ease;
            opacity: 0;
            filter: drop-shadow(0 2px 6px rgba(80, 140, 50, 0.15));
        }

        .liyev-avatar img.img-loaded {
            opacity: 1;
        }

        .liyev-wrapper:hover .liyev-avatar img {
            transform: scale(1.04);
        }

        .liyev-avatar.img-error {
            display: none;
        }

        /* ===== 对话内容区 ===== */
        .liyev-dialogue {
            flex-grow: 1;
            padding: 18px 22px 18px 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 0;
        }

        /* 名称行：名字 + 情绪标签组 */
        .liyev-name-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 12px;
            margin-bottom: 10px;
        }

        .liyev-name {
            font-size: 15px;
            font-weight: 700;
            color: #6a9e3a;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        /* ---- 情绪标签容器 ---- */
        .liyev-moods {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 8px;
            align-items: center;
        }

        /* 单个情绪标签 —— 仅显示文字，无 emoji */
        .liyev-mood {
            display: inline-flex;
            align-items: center;
            font-size: 12px;
            font-weight: 500;
            padding: 3px 14px;
            border-radius: 20px;
            border: 1px solid #c8e0b0;
            background: #eef8e0;
            color: #5a7a3a;
            letter-spacing: 0.3px;
            line-height: 1.5;
            white-space: nowrap;
            transition: all 0.25s ease;
            box-shadow: 0 1px 3px rgba(100, 160, 60, 0.06);
        }

        /* ---------- 情绪颜色主题 ---------- */
        /* 表层伪装·天真无害 : 嫩绿 / 薄荷色系 */
        .liyev-mood.mood-innocent {
            background: #f2fce8;
            border-color: #b8e090;
            color: #5a8a30;
        }

        /* 表层伪装·关心担忧 : 浅绿带一点柔软暖色 */
        .liyev-mood.mood-worried {
            background: #fafdf5;
            border-color: #d0e0b8;
            color: #7a9060;
        }

        /* 里层暴露·愉悦恶趣味 : 深绿色带危险暗调 */
        .liyev-mood.mood-amused {
            background: #e8f5d8;
            border-color: #80a050;
            color: #3d5a18;
        }

        /* 里层暴露·狂热病态 : 暗绿混合暗红 */
        .liyev-mood.mood-dangerous {
