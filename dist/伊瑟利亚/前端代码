            .liyev-avatar img {
                max-height: 68px;
                border-radius: 6px;
            }

            .liyev-dialogue {
                padding: 10px 12px 10px 8px;
            }

            .liyev-name {
                font-size: 12px;
            }

            .liyev-mood {
                font-size: 10px;
                padding: 1px 10px;
            }

            .liyev-text {
                font-size: 13px;
                line-height: 1.6;
            }
        }

        .liyev-moods {
            max-width: 100%;
        }
    </style>
</head>
<body>
    <div id="main-container"></div>

    <script>
        /* ============================================================
         *  1. 情绪 → 颜色主题分类（莉耶芙专属）
         * ============================================================ */
        function getMoodTheme(emotion) {
            /* 表层伪装 — 天真无害 */
            var innocent = ['天真', '纯真', '元气', '活泼', '撒娇', '黏人'];
            /* 表层伪装 — 关心担忧 */
            var worried = ['担忧', '关心', '不安', '胆小', '自责'];
            /* 里层暴露 — 愉悦恶趣味 */
            var amused = ['愉悦', '恶趣味', '阴阳怪气', '戏谑', '嘻嘻'];
            /* 里层暴露 — 狂热病态 */
            var dangerous = ['狂热', '病态', '兴奋', '疯狂', '占有'];
            /* 完全暴露 — 纯粹恶意 */
            var dark = ['漠然', '冷漠', '残酷', '黑化'];

            if (dark.includes(emotion)) return 'dark';
            if (dangerous.includes(emotion)) return 'dangerous';
            if (amused.includes(emotion)) return 'amused';
            if (worried.includes(emotion)) return 'worried';
            if (innocent.includes(emotion)) return 'innocent';
            return 'innocent';
        }

        /* ============================================================
         *  2. 分割多个情绪词
         * ============================================================ */
        function splitEmotions(raw) {
            if (!raw || typeof raw !== 'string') return [];
            var parts = raw.split(/[,，、\/\s|]+/);
            var result = [];
            for (var i = 0; i < parts.length; i++) {
                var s = parts[i].trim();
                if (s.length > 0) {
                    result.push(s);
                }
            }
            return result;
        }

        /* ============================================================
         *  3. 主渲染逻辑（纯文字标签）
         * ============================================================ */
        function init() {
            try {
                var emotionRaw = '$1';
                var textRaw = '$2';

                var emotionList = splitEmotions(emotionRaw);
                var finalEmotions = emotionList.length > 0 ? emotionList : ['天真'];

                var text = textRaw.trim();
                if (!text || text === '$2') {
                    return;
                }

                var avatarDefault = 'https://zora404.dpdns.org/file/1784747096865_ComfyUI_temp_nxilb_00002_.png';
                var avatarShy = 'https://zora404.dpdns.org/file/1784747649999_人物差分修改__1_.png';
                var avatarSurprise = 'https://zora404.dpdns.org/file/1784747647044_人物差分修改.png';
                var avatarMorbid = 'https://zora404.dpdns.org/file/1784747958614_去掉对话框.png';

                // 根据第一情绪选择对应头像
                var avatarUrl = avatarDefault;
                var primaryEmotion = finalEmotions[0] || '';
                if (primaryEmotion.indexOf('羞涩') !== -1 || primaryEmotion.indexOf('害羞') !== -1) {
                    avatarUrl = avatarShy;
                } else if (primaryEmotion.indexOf('惊讶') !== -1 || primaryEmotion.indexOf('担忧') !== -1 || primaryEmotion.indexOf('震惊') !== -1) {
                    avatarUrl = avatarSurprise;
                } else if (primaryEmotion.indexOf('病态') !== -1 || primaryEmotion.indexOf('残酷') !== -1 || primaryEmotion.indexOf('愉悦') !== -1 || primaryEmotion.indexOf('狂热') !== -1) {
                    avatarUrl = avatarMorbid;
                }

                /* 构建情绪标签 HTML */
                var moodsHtml = '';
                for (var i = 0; i < finalEmotions.length; i++) {
                    var emotion = finalEmotions[i];
                    var theme = getMoodTheme(emotion);
                    var delay = i * 50;
                    moodsHtml += '<span class="liyev-mood mood-' + theme + '" style="animation: fadeInLiyev 0.4s ease ' + delay + 'ms both;">' + emotion + '</span>';
                }

                var html = '';
                html += '<div class="liyev-wrapper">';
                html += '  <div class="liyev-avatar" id="liyev-avatar-container">';
                html += '    <img src="' + avatarUrl + '" alt="莉耶芙" loading="lazy" onerror="document.getElementById(\'liyev-avatar-container\').classList.add(\'img-error\');" onload="this.classList.add(\'img-loaded\');">';
                html += '  </div>';
                html += '  <div class="liyev-dialogue">';
                html += '    <div class="liyev-name-row">';
                html += '      <span class="liyev-name">✦ 指引妖精莉耶芙</span>';
                html += '      <div class="liyev-moods">' + moodsHtml + '</div>';
                html += '    </div>';
                html += '    <div class="liyev-text">' + text + '</div>';
                html += '  </div>';
                html += '</div>';

                document.getElementById('main-container').innerHTML = html;

            } catch (error) {
                console.error('[莉耶芙渲染] 错误:', error);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
</html>
