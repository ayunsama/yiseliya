            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        /* ===== 响应式 ===== */
        @media (max-width: 540px) {
            .liyev-wrapper {
                margin: 5px 0;
                border-radius: 14px;
                flex-wrap: nowrap;
            }

            .liyev-avatar {
