        }
        // ===== 超智能值渲染：点号路径按 . 拆段（世界设定.落日哨所.详细说明 → 层级胶囊）=========
        // 数值增量 +5/-10 高亮；→ 箭头保留
        function smartVal(value) {
            var raw = String(value == null ? '' : value);
            var out = '';
            // 按点号路径分段：整段 xxx.yyy.zzz（段内仅纯词元，排除空白/标点/括号/加减号）
