        /* ===== 布局骨架 ===== */
        .stage { width: 100%; max-width: 760px; }
        .scroll-frame { position: relative; padding: 16px 0 20px; }
        .scroll { width: 100%; position: relative; overflow: hidden; border-radius: 3px; }
        .content { position: relative; z-index: 2; line-height: 1.85; font-size: 0.95em; animation: scrollIn .65s ease-out; }
        @keyframes scrollIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

        /* ===== 卷轴本体：羊皮纸 + 暗角 + 横线 + 噪点 ===== */
        .scroll {
            padding: 42px 30px 48px;
            background:
