        body.theme-royal .phase-title { color: #f0d48a; border-color: rgba(212,175,55,.4); background: linear-gradient(135deg, rgba(212,175,55,.16), rgba(120,90,20,.08)); text-shadow: 0 0 6px rgba(212,175,55,.4); }
