        // ===== 演示数据（浏览器直接打开后加 #demo 预览；酒馆正则注入数据时用不到） =====
        var DEMO_TEXT = '<鉴定结算>\n  {内政判定}\n  | 领地: 蔷薇镇 | 规模等级: 城镇 | 变种: 农耕村 | 事项: 兴修水利 | 难度DC: 14 |\n  | 掷骰: 领主治政 d20(16) + 4 = 20 vs DC 14 | 判定结果: 成功 |\n  | 效果: 水利设施推进，农业产出提升 |\n  | 面板更新: 经济.国库 -200 → 资金流动良性 |\n  叙事指导: (领主亲临工地勘察河道，村民围观，工程缓慢推进。)\n  {外交判定}\n  | 领地: 蔷薇镇 | 对象: 灰鸥港商会 | 事项: 贸易协定 | 难度DC: 12 |\n  | 掷骰: 领地使节 d20(08) + 3 = 11 vs DC 12 | 判定结果: 失败 |\n  | 效果: 商会持观望态度，协议搁置 |\n  | 面板更新: 外交.贸易协定 暂无新增 |\n  叙事指导: (使节呈上条款文书，商会代表面色迟疑，收回手。)\n</鉴定结算>\n';
        function showWaiting() {
            document.getElementById('trtContent').innerHTML = '<div style="text-align:center; color:#8a6914; font-weight:600; letter-spacing:2px; padding:32px 0;">─ 展开领地裁定书 ─</div>';
        }
        // 智能读取：#rawData 可能是「裸 <鉴定结算> 标签注入」（浏览器当元素，innerHTML 保留字面量）
