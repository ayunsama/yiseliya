        .check-line { margin: 7px 0; padding: 7px 20px; background: linear-gradient(180deg, rgba(90,58,138,.13), rgba(90,58,138,.05)); border: 1px solid rgba(90,58,138,.30); border-radius: 999px; font-size: .95em; width: fit-content; max-width: 100%; box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 1px 4px rgba(120,80,30,.10); }
