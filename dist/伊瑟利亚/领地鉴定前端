        .vchip { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; flex-wrap: wrap; word-break: break-word; overflow-wrap: anywhere; background: linear-gradient(180deg, rgba(255,250,238,.95), rgba(240,226,196,.88)); border: 1px solid rgba(160,120,64,.42); border-radius: 999px; padding: 3px 13px; box-shadow: 0 1px 4px rgba(120,80,30,.12), inset 0 1px 0 rgba(255,255,255,.55); transition: all .2s; }
