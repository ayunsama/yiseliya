        .phase-block::before { content: ""; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; background: linear-gradient(180deg, transparent, var(--phase, #c4a050), transparent); border-radius: 2px; }
        .phase-marker { text-align: center; margin: 2px 0 10px; padding: 4px 0; }
        .phase-title { display: inline-block; padding: 4px 20px; background: var(--wash, linear-gradient(135deg, rgba(180,150,60,.16), rgba(160,130,50,.08))); border: 1px solid var(--phase, #c4a050); border-radius: 3px; color: #5a3a08; font-weight: 700; font-size: 1.05em; letter-spacing: 4px; box-shadow: 0 1px 3px rgba(120,80,30,.18); }
        .phase-icon { display: inline-block; margin: 0 6px; font-size: 1em; color: var(--phase, #a07828); }

        /* ===== 数据行 ===== */
