        /* 点号路径层级段：每段独立小胶囊 + · 连接 */
        .pathseg { display: inline-flex; align-items: center; background: rgba(120,90,40,.10); border: 1px solid rgba(160,120,64,.35); color: #7a4a12; font-weight: 700; font-size: .88em; border-radius: 8px; padding: 1px 8px; white-space: nowrap; }
