            if (!hasTerritory) hasTerritory = true; // 无领地行也不影响拼接
            var html = '<div class="scroll-header"><div class="head-orn">─ ✦ ─</div><div class="head-title">领地鉴定</div><div class="head-sub">' + esc(buildHeadSub()) + '</div><div class="head-rule"></div></div>';
            blocks.forEach(function (b) {
