                    return '<div class="check-line">⚄ <span class="check-dice">' + esc(m[1]) + ' d20(' + m[2] + ')</span> + <span class="check-dice">' + m[3] + '</span> = <span class="check-total">' + m[4] + '</span> <span style="color:#8a6a3a;">vs</span> DC <span class="check-dc">' + m[5] + '</span></div>';
