        function renderAdjudication(text) {
            var blocks = parseAdjudication(text);
            if (!blocks.length) return '<div class="err-msg">※ 未见领地鉴定记录 ※</div>';
            var hasTerritory = false, firstTier = '', firstVariant = '';
            blocks.forEach(function (b) {
                b.rows.forEach(function (pair) {
