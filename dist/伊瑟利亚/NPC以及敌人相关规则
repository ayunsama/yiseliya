        /* ========== 将NPC数据写入固定世界书“伊瑟利亚NPC数据”（蓝灯常驻） ========== */
        function addNpcToWorldbook(npcData) {
            var helper = getHelper();
            var WORLD_BOOK_NAME = '伊瑟利亚NPC数据';
            var entryName = npcData.name || '未命名NPC';

            // 写入世界书的内容：包含所有属性、攻击、能力等详细数值
            var contentParts = [];
            if (npcData.name) contentParts.push('【姓名】' + npcData.name);
            if (npcData.race) contentParts.push('【种族】' + npcData.race);
            if (npcData.identity) contentParts.push('【身份】' + npcData.identity);
            if (npcData.gender) contentParts.push('【性别】' + npcData.gender);
            if (npcData.age) contentParts.push('【年龄】' + npcData.age);
            if (npcData.appear) contentParts.push('【外貌】' + npcData.appear);
            if (npcData.personality) contentParts.push('【性格】' + npcData.personality);
            if (npcData.bgStory) contentParts.push('【背景】' + npcData.bgStory);
            if (npcData.blessing) contentParts.push('【加护】' + npcData.blessing);
            if (npcData.faction) contentParts.push('【所属势力】' + npcData.faction);
            if (npcData.tier) contentParts.push('【等阶】' + npcData.tier);
            if (npcData.level) contentParts.push('【等级】' + npcData.level);
            contentParts.push('【HP】' + npcData.hpCur + '/' + npcData.hpMax);
            contentParts.push('【防御值】' + npcData.def);
            contentParts.push('【移动速度】' + npcData.spd);
            contentParts.push('【先攻修正】' + fmod(npcData.init));
            contentParts.push('【属性】力量' + npcData.attr.str + ' 敏捷' + npcData.attr.dex + ' 体质' + npcData.attr.con + ' 智力' + npcData.attr.int + ' 感知' + npcData.attr.wis + ' 魅力' + npcData.attr.cha);
            if (npcData.attacks.length > 0) {
                for (var ai = 0; ai < npcData.attacks.length; ai++) {
                    var atk = npcData.attacks[ai];
                    contentParts.push('【攻击】' + atk.name + ' | ' + atk.type + ' | 命中' + atk.hit + ' | 伤害' + atk.dmg + (atk.eff ? ' | ' + atk.eff : ''));
                }
            }
            if (npcData.abilities.length > 0) {
                for (var bi = 0; bi < npcData.abilities.length; bi++) {
                    var abl = npcData.abilities[bi];
                    contentParts.push('【能力】' + abl.name + ' | ' + abl.desc);
                }
            }
            if (npcData.equips && npcData.equips.length > 0) {
                for (var ei = 0; ei < npcData.equips.length; ei++) {
                    var eqp = npcData.equips[ei];
                    contentParts.push('【装备】' + eqp.slot + ' | ' + eqp.name + (eqp.desc ? ' | ' + eqp.desc : ''));
                }
            }
            if (npcData.items && npcData.items.length > 0) {
                for (var ji = 0; ji < npcData.items.length; ji++) {
                    var itm = npcData.items[ji];
                    contentParts.push('【随身物品】' + itm.name + ' ×' + (itm.qty || 1) + (itm.desc ? ' | ' + itm.desc : ''));
                }
            }
            if (npcData.attitude) contentParts.push('【态度】' + npcData.attitude);
            if (npcData.affinity) contentParts.push('【好感度】' + npcData.affinity);
            if (npcData.status) contentParts.push('【状态】' + npcData.status);

            var entryContent = contentParts.join('\n');

            // 获取 API 引用
            var getWorldbook = helper.getWorldbook || window.getWorldbook;
            var createWorldbook = helper.createWorldbook || window.createWorldbook;
            var updateWorldbookWith = helper.updateWorldbookWith || window.updateWorldbookWith;
            var getGlobalNames = helper.getGlobalWorldbookNames || window.getGlobalWorldbookNames;
            var rebindGlobal = helper.rebindGlobalWorldbooks || window.rebindGlobalWorldbooks;

            if (!getWorldbook || !createWorldbook || !updateWorldbookWith || !getGlobalNames || !rebindGlobal) {
                showResult('wb-result', false, '✗ 世界书 API 不可用，请在酒馆扩展中使用');
                console.error('[世界书] 缺少 API 函数', { getWorldbook, createWorldbook, updateWorldbookWith, getGlobalNames, rebindGlobal });
                return;
            }

            console.log('[世界书] 开始处理 NPC:', entryName);
            console.log('[世界书] 条目内容:\n', entryContent);

            // 1. 确保世界书存在
            var ensureBook = getWorldbook(WORLD_BOOK_NAME).catch(function(err) {
                console.log('[世界书] 世界书不存在，将自动创建:', WORLD_BOOK_NAME, err);
                return createWorldbook(WORLD_BOOK_NAME, []).then(function() {
                    console.log('[世界书] 空世界书已创建');
                    return [];
                });
            });

            ensureBook.then(function(existingEntries) {
                console.log('[世界书] 当前条目数:', existingEntries.length);
                // 2. 更新或新增条目
                return updateWorldbookWith(WORLD_BOOK_NAME, function(entries) {
                    var existingIndex = -1;
                    for (var i = 0; i < entries.length; i++) {
                        if (entries[i].name === entryName) {
                            existingIndex = i;
                            break;
                        }
                    }

                    var newEntry = {
                        name: entryName,
                        enabled: true,
                        strategy: {
                            type: 'constant',   // 蓝灯常驻
                            keys: [],
                            keys_secondary: { logic: 'and_any', keys: [] },
                            scan_depth: 'same_as_global'
                        },
                        position: {
                            type: 'before_character_definition',
                            role: 'system',
                            depth: 0,
                            order: 100
                        },
                        content: entryContent
                    };

                    if (existingIndex >= 0) {
                        console.log('[世界书] 更新现有条目:', entryName);
                        entries[existingIndex] = Object.assign(entries[existingIndex], newEntry);
                    } else {
                        console.log('[世界书] 添加新条目:', entryName);
                        entries.push(newEntry);
                    }
                    return entries;
                }, { render: 'immediate' });
            })
            .then(function(updatedEntries) {
                console.log('[世界书] 条目更新完成，当前总数:', updatedEntries.length);
                // 3. 确保全局启用（getGlobalNames 同步返回数组）
                var globalNames = getGlobalNames();
                console.log('[世界书] 当前全局世界书:', globalNames);
                if (globalNames.indexOf(WORLD_BOOK_NAME) === -1) {
                    globalNames.push(WORLD_BOOK_NAME);
                    console.log('[世界书] 将全局启用世界书:', WORLD_BOOK_NAME);
                    return rebindGlobal(globalNames);
                } else {
                    console.log('[世界书] 世界书已在全局列表中');
                }
            })
            .then(function() {
                showResult('wb-result', true, '✓ 已将“' + entryName + '”写入世界书并全局启用');
                console.log('[世界书] 操作成功完成');
            })
            .catch(function(err) {
                showResult('wb-result', false, '✗ 操作失败: ' + (err.message || err));
                console.error('[世界书] 操作失败:', err);
            });
        }

