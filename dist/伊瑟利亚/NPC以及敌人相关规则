<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Noto+Serif+SC:wght@400;700&display=swap');

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: "Noto Serif SC", "SimSun", serif;
            background: transparent;
            padding: 8px;
        }

        .scroll-panel {
            max-width: 430px;
            margin: 0 auto;
            position: relative;
            border-radius: 4px;
        }

        .scroll-border {
            padding: 4px;
            background: linear-gradient(135deg, #a07830, #d4a850, #8b6520, #c49840, #a07830);
            border-radius: 6px;
            box-shadow: 0 3px 10px rgba(60,40,10,0.5), inset 0 1px 0 rgba(255,220,150,0.3);
        }

        .scroll-inner {
            background: linear-gradient(170deg, #f5e6c8 0%, #eddcb0 30%, #e8d4a2 60%, #f0deb4 100%);
            border-radius: 3px;
            position: relative;
            overflow: hidden;
        }

        .scroll-inner::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse at 20% 50%, rgba(180,150,100,0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 20%, rgba(160,130,80,0.06) 0%, transparent 40%),
                radial-gradient(ellipse at 50% 80%, rgba(140,110,60,0.05) 0%, transparent 45%);
            pointer-events: none;
        }

        .scroll-inner::after {
            content: '';
            position: absolute;
            top: 8px; left: 8px; right: 8px; bottom: 8px;
            border: 1px solid rgba(139,101,32,0.25);
            border-radius: 2px;
            pointer-events: none;
        }

        .corner-deco { position: absolute; width: 28px; height: 28px; z-index: 2; }
        .corner-deco::before, .corner-deco::after { content: ''; position: absolute; background: #a07830; }
        .c-tl { top: 12px; left: 12px; }
        .c-tl::before { width: 16px; height: 2px; top: 0; left: 0; }
        .c-tl::after { width: 2px; height: 16px; top: 0; left: 0; }
        .c-tr { top: 12px; right: 12px; }
        .c-tr::before { width: 16px; height: 2px; top: 0; right: 0; }
        .c-tr::after { width: 2px; height: 16px; top: 0; right: 0; }
        .c-bl { bottom: 12px; left: 12px; }
        .c-bl::before { width: 16px; height: 2px; bottom: 0; left: 0; }
        .c-bl::after { width: 2px; height: 16px; bottom: 0; left: 0; }
        .c-br { bottom: 12px; right: 12px; }
        .c-br::before { width: 16px; height: 2px; bottom: 0; right: 0; }
        .c-br::after { width: 2px; height: 16px; bottom: 0; right: 0; }

        .panel-head { padding: 16px 20px 12px; text-align: center; position: relative; }
        .head-icon { font-size: 28px; margin-bottom: 4px; }
        .head-name { font-family: 'Cinzel', 'Noto Serif SC', serif; font-size: 22px; font-weight: 700; color: #2a1a08; letter-spacing: 2px; text-shadow: 0 1px 0 rgba(200,170,100,0.5); }
        .head-sub { font-size: 12px; color: #6b5030; margin-top: 4px; letter-spacing: 1px; }
        .head-badge { display: inline-block; margin-top: 8px; padding: 3px 14px; border-radius: 3px; font-size: 12px; font-weight: 700; letter-spacing: 2px; border: 1px solid; }

        .badge-普通 { background: #e8dcc0; border-color: #a09070; color: #5a4a30; }
        .badge-超凡 { background: #d0e4f4; border-color: #5090c0; color: #1a4a7a; }
