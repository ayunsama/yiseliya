        function bindContractActions(d) {
            var btnContract = document.getElementById('btn-write-contract');
            if(btnContract) btnContract.addEventListener('click', function(){ loadAsContract(d); });
            var sw = document.getElementById('elem-switch');
            if(sw) sw.addEventListener('click', function(ev){
                var t = ev.target;
                var btn = t && t.closest ? t.closest('.elem-btn') : (t && t.classList && t.classList.contains('elem-btn') ? t : null);
                if(!btn) return;
                d.element = btn.getAttribute('data-elem');
                document.getElementById('content').innerHTML = renderContract(d);
                bindContractActions(d);
            });
        }

