        .hp-bar-bg { height: 14px; background: #c8b890; border-radius: 7px; border: 2px solid #8b7040; overflow: hidden; box-shadow: inset 0 2px 4px rgba(0,0,0,0.2); }
        .hp-bar-fill { height: 100%; background: linear-gradient(90deg, #8b2020, #c03030, #d04040); border-radius: 5px; box-shadow: 0 0 6px rgba(180,40,40,0.4); transition: width 0.3s; }

        .aff-area { padding: 6px 24px 10px; }
