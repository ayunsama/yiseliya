            r.spd=parseInt(g(/\[移动速度\|([^\]]+)\]/))||0;
            r.init=parseInt(g(/\[先攻修正\|([^\]]+)\]/))||0;
            var at=t.match(/\[属性\|力量([^\|]+)\|敏捷([^\|]+)\|体质([^\|]+)\|智力([^\|]+)\|感知([^\|]+)\|魅力([^\]]+)\]/);
            if(at){r.attr={str:parseInt(at[1])||0,dex:parseInt(at[2])||0,con:parseInt(at[3])||0,int:parseInt(at[4])||0,wis:parseInt(at[5])||0,cha:parseInt(at[6])||0};}
