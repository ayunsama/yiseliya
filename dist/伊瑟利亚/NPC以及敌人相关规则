                     ougis:[],powers:[],
                     weak:'',resist:'',immune:'',loot:[],exp:0,appear:'',status:''};
            var m = raw.match(/<enemy_data>([\s\S]*?)<\/enemy_data>/);
            if(!m) return r;
            var t = m[1];
            var g = function(re){var x=t.match(re);return x?x[1]:'';};
            r.name=g(/\[名称\|([^\]]+)\]/);
            r.type=g(/\[种类\|([^\]]+)\]/);
            r.race=g(/\[种族\|([^\]]+)\]/);
