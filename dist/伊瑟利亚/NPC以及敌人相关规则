                var dtype = detectType(rawData);
                if(dtype==='enemy'){
                    document.getElementById('content').innerHTML = renderEnemy(parseEnemy(rawData));
                } else if(dtype==='npc'){
                    var npcData = parseNPC(rawData);
                    document.getElementById('content').innerHTML = renderNPC(npcData);

                    var btnNpc = document.getElementById('btn-load-npc');
                    var btnComp = document.getElementById('btn-load-comp');
                    if(btnNpc) btnNpc.addEventListener('click', function(){ loadAsNPC(npcData); });
                    if(btnComp) btnComp.addEventListener('click', function(){ loadAsCompanion(npcData); });

                    var btnWb = document.getElementById('btn-create-wb');
                    if(btnWb) btnWb.addEventListener('click', function(){ addNpcToWorldbook(npcData); });
                } else if(dtype==='summon'){
                    var summonData = parseSummon(rawData);
                    document.getElementById('content').innerHTML = renderSummon(summonData);

                    var btnSummon = document.getElementById('btn-write-summon');
                    if(btnSummon) btnSummon.addEventListener('click', function(){ loadAsSummon(summonData); });
                } else if(dtype==='contract'){
                    var contractData = parseContract(rawData);
                    document.getElementById('content').innerHTML = renderContract(contractData);
                    bindContractActions(contractData);
                } else if(dtype==='cluster'){
                    document.getElementById('content').innerHTML = renderCluster(parseCluster(rawData));
