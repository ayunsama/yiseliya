        // ougis: 单行字符串数组，形如 "奥义名: 效果" 或 "奥义名（限定）: 效果"
        function ougiBlockList(list, secCls, secLabel, nameCls, descCls) {
            var h = '';
            if (!list || !list.length) return h;
            h += '<div class="' + secCls + '">' + secLabel + '</div>';
            for (var i = 0; i < list.length; i++) {
                var raw = String(list[i] || '').trim();
                if (!raw) continue;
                var idx = raw.indexOf(':');
                var nm = (idx > -1 ? raw.slice(0, idx) : raw).trim();
                var ds = (idx > -1 ? raw.slice(idx + 1) : '').trim();
                h += '<div class="' + (secCls === 'power-sec' ? 'power-block' : 'ougi-block') + '">';
                h += '<div class="' + nameCls + '">' + nm + '</div>';
                if (ds) h += '<div class="' + descCls + '">' + ds + '</div>';
                h += '</div>';
            }
            return h;
        }

