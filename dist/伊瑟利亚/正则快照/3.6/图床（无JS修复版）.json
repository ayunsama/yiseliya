 "replaceString": "<div class=\"location-card\" data-location=\"$1\">\n  <div class=\"loc-image\">\n    <div class=\"loc-name-overlay\">$1</div>\n  </div>\n</div>\n<style>\n.location-card {\n  max-width: 600px;\n  margin: 16px auto;\n  border-radius: 8px;\n  overflow: hidden;\n  box-shadow: 0 4px 15px rgba(0,0,0,.3);\n  border: 1px solid rgba(255,255,255,.1);\n  background: #1a1a1a;\n}\n.location-card .loc-image {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 16 / 9;\n  background-color: #2a2a2a;\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  transition: transform .5s ease;\n}\n.location-card .loc-image:hover {\n  transform: scale(1.03);\n}\n.location-card .loc-name-overlay {\n  position: absolute;\n  box-sizing: border-box;\n  bottom: 0;\n  left: 0;\n  width: 100%;\n  padding: 20px 16px 12px;\n  background: linear-gradient(to top, rgba(0,0,0,.85), rgba(0,0,0,0));\n  color: #fff;\n  font-size: 1.2em;\n  font-weight: bold;\n  text-shadow: 1px 1px 3px rgba(0,0,0,.8);\n}\n.location-card[data-location=\"铁锚营\"] .loc-image {background-image:url(\"https://zora404.dpdns.org/file/1783971046280_铁锚营.png\");}\n.location-card[data-location=\"蓝光谷\"] .loc-image {background-image:url(\"https://zora404.dpdns.org/file/1783971046658_蓝光谷.png\");}\n.location-card[data-location=\"沉木城\"] .loc-image {background-image:url(\"https://zora404.dpdns.org/file/1783971047440_沉木城.png\");}\n.location-card[data-location=\"裂隙之门\"] .loc-image {background-image:url(\"https://zora404.dpdns.org/file/1783971055844_裂隙之门.png\");}\n.location-card[data-location=\"朽龙巢\"] .loc-image {background-image:url(\"https://zora404.dpdns.org/file/1783971065007_朽龙巢.png\");}\n.location-card[data-location=\"格洛斯特\"] .loc-image {background-image:url(\"https://zora404.dpdns.org/file/1783971063637_格洛斯特.png\");}\n.location-card[data-location=\"白崖修道院\"] .loc-image {background-image:url(\"https://zora404.dpdns.org/file/1783971067655_白崖修道院.png\");}\n.location-card[data-locati