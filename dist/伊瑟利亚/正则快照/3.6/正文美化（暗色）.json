{
 "id": "e9ebe38a-7c59-460e-bab6-7cd3b880b66a",
 "scriptName": "正文美化（暗色）",
 "disabled": false,
 "runOnEdit": true,
 "findRegex": "/<content>([\\s\\S]*?)</content>/g",
 "replaceString": "<div data-parchment style=\"\n  width: 100%;\n  max-width: 100%;\n  min-height: 160px;\n  margin: 16px auto;\n  position: relative;\n  overflow: hidden;\n  contain: layout paint;\n  padding: 18px;\n  box-sizing: border-box;\n  background:\n    radial-gradient(ellipse 120% 80% at 18% 0%, var(--pt-glow, rgba(255, 236, 190, 0.05)), transparent 55%),\n    radial-gradient(ellipse 100% 70% at 82% 100%, var(--pt-glow2, rgba(0, 0, 0, 0.18)), transparent 60%),\n    repeating-linear-gradient(\n      0deg,\n      transparent,\n      transparent 3px,\n      var(--pt-haze, rgba(226, 196, 130, 0.035)) 3px,\n      var(--pt-haze, rgba(226, 196, 130, 0.035)) 4px\n    ),\n    linear-gradient(168deg, var(--pt-bg1) 0%, var(--pt-bg2) 34%, var(--pt-bg3) 62%, var(--pt-bg4) 100%);\n  border: 2px solid var(--pt-border);\n  border-radius: 3px;\n  box-shadow:\n    0 6px 24px var(--pt-shadow),\n    inset 0 0 40px var(--pt-shadow),\n    0 0 0 1px var(--pt-ring);\n  font-family: 'ZhuqueFangsong', 'Noto Serif SC', serif;\n  color: var(--pt-text);\n\">\n\n  <!-- ⚙ 风格设置开关（checkbox hack，纯 CSS，无需 JS 即可开合） -->\n  <label class=\"pt-cfg-btn\" title=\"切换背景风格\">\n    <input type=\"checkbox\" class=\"pt-toggle\">\n    <span class=\"pt-cfg-icon\">⚙</span>\n  </label>\n\n  <!-- 风格面板 -->\n  <div class=\"pt-cfg-panel\">\n    <div class=\"pt-cfg-title\">◈ 背景风格 ◈</div>\n    <div class=\"pt-chips\">\n      <label class=\"pt-chip\"><input type=\"radio\" name=\"pt-theme\" value=\"parchment\" checked>暗色羊皮纸</label>\n      <label class=\"pt-chip\"><input type=\"radio\" name=\"pt-theme\" value=\"simple\">简约羊皮纸</label>\n      <label class=\"pt-chip\"><input type=\"radio\" name=\"pt-theme\" value=\"royal\">王室暗金</label>\n      <label class=\"pt-chip\"><input type=\"radio\" name=\"pt-theme\" value=\"dawn\">晨曦黎明</label>\n      <label class=\"pt-chip\"><input type=\"radio\" name=\"pt-theme\" value=\"night\">苍蓝夜曲</label>\n    </div>\n    <div class=\"pt-cfg-divider\"></div>\n    <div class=\"pt-cfg-sub\">字 号</div>\n    <div class=\"pt-chips\">\n      <label class=\"pt-chip pt-font-chip\"><input type=\"radio\" name=\"pt-font\" value=\"f13\">小</label>\n      <label class=\"pt-chip pt-font-chip\"><input type=\"radio\" name=\"pt-font\" value=\"f14\" checked>标准</label>\n      <label class=\"pt-chip pt-font-chip\"><input type=\"radio\" name=\"pt-font\" value=\"f16\">大</label>\n      <label class=\"pt-chip pt-font-chip\"><input type=\"radio\" name=\"pt-font\" value=\"f18\">特大</label>\n    </div>\n  </div>\n\n  <!-- 边缘做旧（暗色下更深的暗角） -->\n  <div data-edge style=\"\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(ellipse 80% 15% at 50% 0%, var(--pt-edge-top), transparent 70%),\n      radial-gradient(ellipse 60% 12% at 50% 100%, var(--pt-edge-bottom), transparent 70%);\n    pointer-events: none;\n    z-index: 0;\n  \"></div>\n\n  <!-- 四角铁质包边 -->\n  <div style=\"position:absolute;top:-1px;left:-1px;width:44px;height:44px;border-top:3px solid var(--pt-corner);border-left:3px solid var(--pt-corner);opacity:var(--pt-corner-op);z-index:1;border-radius:2px 0 0 0;\"></div>\n  <div style=\"position:absolute;top:-1px;right:-1px;width:44px;height:44px;border-top:3px solid var(--pt-corner);border-right:3px solid var(--pt-corner);opacity:var(--pt-corner-op);z-index:1;border-radius:0 2px 0 0;\"></div>\n  <div style=\"position:absolute;bottom:-1px;left:-1px;width:44px;height:44px;border-bottom:3px solid var(--pt-corner);border-left:3px solid var(--pt-corner);opacity:var(--pt-corner-op);z-index:1;border-radius:0 0 0 2px;\"></div>\n  <div style=\"position:absolute;bottom:-1px;right:-1px;width:44px;height:44px;border-bottom:3px solid var(--pt-corner);border-right:3px solid var(--pt-corner);opacity:var(--pt-corner-op);z-index:1;border-radius:0 0 2px 0;\"></div>\n\n  <!-- 纸纹肌理 + 金线内框 -->\n  <div data-texture></div>\n  <div data-innerline></div>\n\n  <!-- 顶部双线装饰 -->\n  <div style=\"position:absolute;top:14px;left:55px;right:55px;height:1px;background:linear-gradient(90deg,transparent,var(--pt-accent),transparent);opacity:0.5;z-index:1;\"></div>\n  <div style=\"position:absolute;top:18px;left:55px;right:55px;height:1px;background:linear-gradient(90deg,transparent,var(--pt-accent),transparent);opacity:0.3;z-index:1;\"></div>\n\n  <!-- 标题栏 -->\n  <div data-title style=\"\n    position: relative;\n    z-index: 2;\n    text-align: center;\n    padding: 12px 0 2px 0;\n  \">\n    <div style=\"display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:4px;\">\n      <span style=\"color:var(--pt-accent);font-size:11px;opacity:0.7;\">✧</span>\n      <div style=\"width:50px;height:1px;background:linear-gradient(90deg,transparent,var(--pt-accent));opacity:0.4;\"></div>\n      <span style=\"color:var(--pt-accent);font-size:10px;letter-spacing:3px;text-transform:uppercase;opacity:0.8;\">The Elder Scroll</span>\n      <div style=\"width:50px;height:1px;background:linear-gradient(-90deg,transparent,var(--pt-accent));opacity:0.4;\"></div>\n      <span style=\"color:var(--pt-accent);font-size:11px;opacity:0.7;\">✧</span>\n    </div>\n\n    <span style=\"\n      display: block;\n      font-size: var(--pt-title-size, clamp(18px, 3.5vw, 22px));\n      color: var(--pt-title);\n      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);\n      font-weight: 500;\n      letter-spacing: 10px;\n      line-height: 1.2;\n      font-family: 'ZhuqueFangsong', 'Noto Serif SC', serif;\n    \">◈ 伊 瑟 利 亚 ◈</span>\n  </div>\n\n  <!-- 分隔宝剑纹章 -->\n  <div style=\"\n    position: relative;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    margin: 4px 0 10px 0;\n    opacity: 0.5;\n  \">\n    <span style=\"font-size:12px;color:var(--pt-accent2);\">⚔</span>\n    <div style=\"width:30px;height:1px;background:var(--pt-accent);\"></div>\n    <span style=\"font-size:10px;color:var(--pt-accent2);\">❖</span>\n    <div style=\"width:30px;height:1px;background:var(--pt-accent);\"></div>\n    <span style=\"font-size:12px;color:var(--pt-accent2);\">⚔</span>\n  </div>\n\n  <!-- 存档/读档按钮排（交互由状态栏脚本宿主补丁接管） -->\n  <div data-iz-savebar style=\"position:relative;z-index:3;display:flex;align-items:center;gap:6px;margin:2px 10px 6px;font-size:11px;flex-wrap:wrap;\">\n    <span style=\"color:var(--pt-accent,#b8934a);letter-spacing:1px;\">◈ 时空存档</span>\n    <button type=\"button\" data-iz-save=\"1\" style=\"cursor:pointer;padding:2px 7px;border:1px solid var(--pt-border,#8b7355);border-radius:5px;background:transparent;color:var(--pt-text,#d8c9a3);font-size:11px;\">💾存一</button>\n    <button type=\"button\" data-iz-load=\"1\" style=\"cursor:pointer;padding:2px 7px;border:1px solid var(--pt-border,#8b7355);border-radius:5px;background:transparent;color:var(--pt-text,#d8c9a3);font-size:11px;opacity:.45;\">📖读一</button>\n    <button type=\"button\" data-iz-save=\"2\" style=\"cursor:pointer;padding:2px 7px;border:1px solid var(--pt-border,#8b7355);border-radius:5px;background:transparent;color:var(--pt-text,#d8c9a3);font-size:11px;\">💾存二</button>\n    <button type=\"button\" data-iz-load=\"2\" style=\"cursor:pointer;padding:2px 7px;border:1px solid var(--pt-border,#8b7355);border-radius:5px;background:transparent;color:var(--pt-text,#d8c9a3);font-size:11px;opacity:.45;\">📖读二</button>\n    <button type=\"button\" data-iz-save=\"3\" style=\"cursor:pointer;padding:2px 7px;border:1px solid var(--pt-border,#8b7355);border-radius:5px;background:transparent;color:var(--pt-text,#d8c9a3);font-size:11px;\">💾存三</button>\n    <button type=\"button\" data-iz-load=\"3\" style=\"cursor:pointer;padding:2px 7px;border:1px solid var(--pt-border,#8b7355);border-radius:5px;background:transparent;color:var(--pt-text,#d8c9a3);font-size:11px;opacity:.45;\">📖读三</button>\n    <span data-iz-info style=\"opacity:.75;\"></span>\n  </div>\n\n  <!-- 正文内容 -->\n  <div data-content style=\"\n    position: relative;\n    z-index: 2;\n    padding: 0 10px;\n    line-height: 2.6;\n    font-size: var(--pt-font, 14px);\n    color: var(--pt-text);\n    letter-spacing: 0.04em;\n    white-space: pre-line;\n  \">\n    $1\n  </div>\n\n  <!-- 底部纹章 -->\n  <div style=\"\n    position: relative;\n    z-index: 2;\n    margin-top: 10px;\n    text-align: center;\n    font-size: 12px;\n    color: var(--pt-accent);\n    opacity: 0.35;\n    letter-spacing: 14px;\n    font-family: serif;\n  \">✧ ◈ ✦ ◈ ✧</div>\n\n  <style>\n    /* ===== 默认主题：暗色羊皮纸（伊瑟利亚） ===== */\n    [data-parchment] {\n      --pt-bg1: #2a2016;\n      --pt-bg2: #3a2b1c;\n      --pt-bg3: #312417;\n      --pt-bg4: #241a10;\n      --pt-haze: rgba(226, 196, 130, 0.035);\n      --pt-border: #b8956a;\n      --pt-text: #e8d5a8;\n      --pt-title: #f0d48a;\n      --pt-accent: #d4b478;\n      --pt-accent2: #c9a86a;\n      --pt-corner: #9a7a45;\n      --pt-corner-op: 0.6;\n      --pt-shadow: rgba(0,0,0,0.45);\n      --pt-ring: rgba(60, 40, 20, 0.5);\n      --pt-edge-top: rgba(0,0,0,0.35);\n      --pt-edge-bottom: rgba(0,0,0,0.30);\n      --pt-quote: #c9a86a;\n      --pt-em: #f0d48a;\n      --pt-link: #e0b96f;\n      --pt-code-bg: rgba(0, 0, 0, 0.35);\n      --pt-glow: rgba(255, 236, 190, 0.05);\n      --pt-glow2: rgba(0, 0, 0, 0.18);\n      --pt-font: 14px;      /* 正文默认字号，随右上面板调节 */\n      --pt-title-size: clamp(18px, 3.5vw, 22px);\n    }\n\n    /* ===== 纸纹肌理 + 金线内框 + 入场动画（升级层） ===== */\n    [data-parchment] [data-texture] {\n      position: absolute;\n      inset: 0;\n      z-index: 0;\n      pointer-events: none;\n      background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"140\" height=\"140\" opacity=\"0.05\"><filter id=\"n\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.72\" numOctaves=\"3\" stitchTiles=\"stitch\"/></filter><rect width=\"100%\" height=\"100%\" filter=\"url(%23n)\"/></svg>');\n      opacity: 0.55;\n    }\n    [data-parchment] [data-innerline] {\n      position: absolute;\n      inset: 7px;\n      border: 1px solid color-mix(in srgb, var(--pt-accent) 30%, transparent);\n      border-radius: 2px;\n      pointer-events: none;\n      z-index: 1;\n    }\n    [data-parchment] [data-innerline]::after {\n      content: \"\";\n      position: absolute;\n      inset: 3px;\n      border: 1px solid color-mix(in srgb, var(--pt-accent) 14%, transparent);\n      border-radius: 1px;\n    }\n    @keyframes pt-in {\n      from { opacity: 0; transform: translateY(8px); }\n      to { opacity: 1; transform: none; }\n    }\n    [data-parchment] { animation: pt-in 0.55s ease-out; }\n\n    /* ===== 字号调节：纯 CSS（:has 监听 radio → 覆盖 --pt-font 与标题字号） ===== */\n    [data-parchment]:has(input[value=\"f13\"]:checked) { --pt-font: 13px; --pt-title-size: clamp(16px, 3.2vw, 20px); }\n    [data-parchment]:has(input[value=\"f16\"]:checked) { --pt-font: 16px; --pt-title-size: clamp(20px, 3.8vw, 24px); }\n    [data-parchment]:has(input[value=\"f18\"]:checked) { --pt-font: 18px; --pt-title-size: clamp(22px, 4.2vw, 27px); }\n\n    /* ===== 主题切换：纯 CSS（:has 监听 radio 选中 → 覆盖本容器变量） ===== */\n    [data-parchment]:has(input[value=\"simple\"]:checked) {\n      --pt-bg1: #f2e6c8; --pt-bg2: #ecdcb8; --pt-bg3: #e6d3a8; --pt-bg4: #dcc79a;\n      --pt-haze: rgba(140, 110, 60, 0.06);\n      --pt-border: #b89a6a; --pt-text: #4a3a22; --pt-title: #7a5a28;\n      --pt-accent: #8a6a38; --pt-accent2: #7a5a30; --pt-corner: #8a6a45; --pt-corner-op: 0.35;\n      --pt-shadow: rgba(80, 60, 30, 0.18); --pt-ring: rgba(120, 90, 50, 0.35);\n      --pt-edge-top: rgba(60, 40, 20, 0.12); --pt-edge-bottom: rgba(60, 40, 20, 0.10);\n      --pt-quote: #7a5a30; --pt-em: #6a4a20; --pt-link: #7a4a1a; --pt-code-bg: rgba(90, 70, 40, 0.08);\n      --pt-glow: rgba(255, 252, 240, 0.5); --pt-glow2: rgba(120, 90, 50, 0.10);\n    }\n    [data-parchment]:has(input[value=\"royal\"]:checked) {\n      --pt-bg1: #1b1626; --pt-bg2: #2a2140; --pt-bg3: #221a34; --pt-bg4: #150f22;\n      --pt-haze: rgba(212, 175, 55, 0.05);\n      --pt-border: #c9a227; --pt-text: #f2e3b3; --pt-title: #ffd75e;\n      --pt-accent: #d4af37; --pt-accent2: #c9a227; --pt-corner: #c9a227; --pt-corner-op: 0.75;\n      --pt-shadow: rgba(0,0,0,0.55); --pt-ring: rgba(201, 162, 39, 0.5);\n      --pt-edge-top: rgba(0,0,0,0.45); --pt-edge-bottom: rgba(0,0,0,0.4);\n      --pt-quote: #d4af37; --pt-em: #ffd75e; --pt-link: #ffd75e; --pt-code-bg: rgba(0,0,0,0.4);\n      --pt-glow: rgba(212, 175, 55, 0.09); --pt-glow2: rgba(0, 0, 0, 0.28);\n    }\n    [data-parchment]:has(input[value=\"dawn\"]:checked) {\n      --pt-bg1: #3a2c1c; --pt-bg2: #56402a; --pt-bg3: #493520; --pt-bg4: #2e2113;\n      --pt-haze: rgba(255, 220, 150, 0.06);\n      --pt-border: #e8c078; --pt-text: #f5e6c4; --pt-title: #ffe9b0;\n      --pt-accent: #f0c870; --pt-accent2: #e0b96f; --pt-corner: #d8a860; --pt-corner-op: 0.6;\n      --pt-shadow: rgba(20,10,5,0.4); --pt-ring: rgba(232, 192, 120, 0.5);\n      --pt-edge-top: rgba(30,15,5,0.25); --pt-edge-bottom: rgba(30,15,5,0.22);\n      --pt-quote: #f0c870; --pt-em: #ffe9b0; --pt-link: #ffe0a0; --pt-code-bg: rgba(0,0,0,0.3);\n      --pt-glow: rgba(255, 220, 150, 0.10); --pt-glow2: rgba(30, 15, 5, 0.20);\n    }\n    [data-parchment]:has(input[value=\"night\"]:checked) {\n      --pt-bg1: #0a1322; --pt-bg2: #16283f; --pt-bg3: #101d30; --pt-bg4: #060c16;\n      --pt-haze: rgba(140, 190, 255, 0.045);\n      --pt-border: #5a8ab8; --pt-text: #cfe0f2; --pt-title: #a8d0f0;\n      --pt-accent: #7ab0dc; --pt-accent2: #6a9ecf; --pt-corner: #6a8ab0; --pt-corner-op: 0.6;\n      --pt-shadow: rgba(0,0,0,0.5); --pt-ring: rgba(90, 138, 184, 0.5);\n      --pt-edge-top: rgba(0,0,0,0.4); --pt-edge-bottom: rgba(0,0,0,0.35);\n      --pt-quote: #7ab0dc; --pt-em: #a8d0f0; --pt-link: #9fc4ec; --pt-code-bg: rgba(0,0,0,0.35);\n      --pt-glow: rgba(122, 176, 220, 0.08); --pt-glow2: rgba(0, 0, 0, 0.30);\n    }\n\n    /* ===== 设置开关（右上角 ⚙，纯 CSS 开合） ===== */\n    .pt-cfg-btn {\n      position: absolute;\n      top: 6px;\n      right: 6px;\n      z-index: 3;\n      width: 34px;\n      height: 34px;\n      border-radius: 50%;\n      border: 1px solid rgba(212, 180, 120, 0.5);\n      background: rgba(30, 22, 14, 0.82);\n      color: #e8d5a8;\n      font-size: 16px;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-shadow: 0 3px 12px rgba(0,0,0,0.45);\n      transition: transform 0.2s, background 0.2s;\n      user-select: none;\n    }\n    .pt-cfg-btn:hover { background: rgba(52, 38, 22, 0.92); }\n    .pt-toggle { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }\n    .pt-cfg-btn:has(.pt-toggle:checked) { transform: rotate(45deg); }\n    .pt-cfg-icon { pointer-events: none; }\n    .pt-cfg-btn:has(.pt-toggle:checked) .pt-cfg-icon { transform: rotate(-45deg); }\n\n    /* ===== 风格面板（依赖 .pt-toggle:checked 的兄弟选择器） ===== */\n    .pt-cfg-panel {\n      position: absolute;\n      top: 46px;\n      right: 6px;\n      z-index: 3;\n      display: none;\n      background: rgba(26, 19, 12, 0.94);\n      border: 1px solid var(--pt-border, #b8956a);\n      border-radius: 8px;\n      padding: 10px 12px;\n      box-shadow: 0 10px 36px rgba(0,0,0,0.6);\n      color: #e8d5a8;\n      max-width: 240px;\n      min-width: 180px;\n    }\n    .pt-cfg-btn:has(.pt-toggle:checked) + .pt-cfg-panel { display: block; }\n    .pt-cfg-title { font-size: 12px; letter-spacing: 4px; color: #f0d48a; text-align: center; margin-bottom: 8px; }\n    .pt-cfg-divider { height: 1px; background: linear-gradient(90deg, transparent, rgba(212, 180, 120, 0.4), transparent); margin: 8px 0; opacity: 0.6; }\n    .pt-cfg-sub { font-size: 11px; letter-spacing: 2px; color: #c9a86a; text-align: center; margin-bottom: 6px; opacity: 0.85; }\n    .pt-chips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }\n    .pt-chip {\n      border: 1px solid #d4b478;\n      background: transparent;\n      color: #e8d5a8;\n      font-family: 'ZhuqueFangsong', 'Noto Serif SC', serif;\n      font-size: 12px;\n      padding: 4px 10px;\n      border-radius: 14px;\n      cursor: pointer;\n      transition: all 0.18s;\n      letter-spacing: 1px;\n      user-select: none;\n    }\n    .pt-chip:hover { background: rgba(212, 180, 120, 0.16); }\n    .pt-chip input { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }\n    .pt-chip:has(input:checked) {\n      background: linear-gradient(135deg, #d4b478, #f0d48a);\n      color: #2a2016;\n      font-weight: 700;\n      box-shadow: 0 2px 8px rgba(212, 180, 120, 0.4);\n    }\n\n    /* ===== 正文样式覆盖（随主题变量变色） ===== */\n    [data-parchment] .mes_quote,\n    [data-parchment] .quote {\n      color: var(--pt-quote) !important;\n      font-style: italic;\n      border-left: 2px solid var(--pt-accent);\n      padding-left: 10px;\n      background: color-mix(in srgb, var(--pt-accent) 8%, transparent);\n      display: block;\n      margin: 4px 0;\n    }\n    [data-parchment] q {\n      color: var(--pt-quote) !important;\n      font-style: italic;\n      border-bottom: 1px solid color-mix(in srgb, var(--pt-accent) 35%, transparent);\n    }\n    [data-parchment] span[style*=\"color\"] { color: var(--pt-text) !important; }\n    [data-parchment] .hljs-string { color: var(--pt-accent) !important; }\n    [data-parchment] .hljs-keyword { color: var(--pt-quote) !important; font-weight: 600; }\n    [data-parchment] a {\n      color: var(--pt-link) !important;\n      text-decoration: underline;\n      text-decoration-color: color-mix(in srgb, var(--pt-accent) 40%, transparent);\n    }\n    [data-parchment] a:hover { color: var(--pt-title) !important; }\n    [data-parchment] em, [data-parchment] i { font-style: normal; font-weight: 700; color: var(--pt-em); }\n    [data-parchment] strong, [data-parchment] b { font-weight: 700; font-style: italic; color: var(--pt-em); }\n    [data-parchment] code {\n      background: var(--pt-code-bg);\n      color: var(--pt-text);\n      padding: 1px 5px;\n      border-radius: 2px;\n      border: 1px solid color-mix(in srgb, var(--pt-accent) 25%, transparent);\n      font-size: 0.9em;\n    }\n    [data-parchment] p { margin: 8px 0; }\n    [data-parchment] ul, [data-parchment] ol { padding-left: 1.6em; color: var(--pt-text); }\n    [data-parchment] li { margin: 2px 0; }\n    [data-parchment] hr {\n      border: none; height: 1px;\n      background: linear-gradient(90deg, transparent, var(--pt-accent), transparent);\n      margin: 8px 0; opacity: 0.4;\n    }\n\n    /* ===== 正文渲染器：章节头（<章节>xxx</章节> → .pt-chapter） =====\n       设计：左对齐大排版——左竖条 + 眉行小标签 + 超大章名 + 尾部金线（无职转生式 editorial 风） */\n    [data-parchment] .pt-chapter {\n      display: block;\n      margin: 30px 4px 20px;\n      padding: 12px 18px 14px 16px;\n      border-left: 4px solid var(--pt-accent);\n      background: linear-gradient(90deg, color-mix(in srgb, var(--pt-accent) 9%, transparent), transparent 72%);\n      animation: pt-in 0.7s ease both;\n    }\n    [data-parchment] .pt-chapter .orn { display: none; }\n    [data-parchment] .pt-chapter::before {\n      content: '▸ 剧情 · 章节';\n      display: block;\n      font-size: 11px; letter-spacing: 5px;\n      color: var(--pt-accent2); opacity: 0.9;\n      margin-bottom: 8px;\n    }\n    [data-parchment] .pt-chapter .nm {\n      display: block;\n      font-size: clamp(22px, 4.6vw, 30px);\n      font-weight: 800; color: var(--pt-title);\n      letter-spacing: 3px; line-height: 1.3;\n      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55);\n    }\n    [data-parchment] .pt-chapter .nm::after {\n      content: ''; display: block; width: 64px; height: 2px;\n      margin-top: 10px;\n      background: linear-gradient(90deg, var(--pt-accent), transparent);\n    }\n\n    /* ===== 正文渲染器：场景卡（<scene location time mood> → .pt-scene） =====\n       设计：编号 + 竖分隔线 + 地点大字 + 时/境元数据行 + 场景摘录（editorial 场景卡）；\n       编号用 CSS counter 自动 01/02/03，每楼羊皮纸容器内重置 */\n    [data-parchment] { counter-reset: ptscene; }\n    [data-parchment] .pt-scene {\n      counter-increment: ptscene;\n      display: flex; align-items: stretch; gap: 16px;\n      margin: 26px 4px 16px; padding: 13px 20px 14px 4px;\n      border-left: 4px solid var(--pt-accent);\n      background: linear-gradient(90deg, color-mix(in srgb, var(--pt-accent) 11%, rgba(0, 0, 0, 0.16)), color-mix(in srgb, var(--pt-accent) 4%, transparent) 70%, transparent);\n      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.18);\n      animation: ptBannerIn 0.65s ease both;\n    }\n    [data-parchment] .pt-scene .no {\n      flex: 0 0 46px;\n      display: flex; align-items: center; justify-content: center;\n      font-family: Georgia, 'Times New Roman', serif;\n      font-size: 32px; font-weight: 400;\n      color: var(--pt-accent); opacity: 0.6;\n      border-right: 1px solid color-mix(in srgb, var(--pt-accent) 35%, transparent);\n    }\n    [data-parchment] .pt-scene .no::before {\n      content: counter(ptscene, decimal-leading-zero);\n    }\n    [data-parchment] .pt-scene .bd {\n      flex: 1; min-width: 0; display: block;\n    }\n    [data-parchment] .pt-scene .loc {\n      font-size: 19px; font-weight: 700; color: var(--pt-title);\n      letter-spacing: 2px; line-height: 1.4;\n      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55), 0 0 14px color-mix(in srgb, var(--pt-accent) 30%, transparent);\n    }\n    [data-parchment] .pt-scene .meta {\n      display: flex; gap: 18px; flex-wrap: wrap;\n      margin-top: 6px;\n      font-size: 12px; letter-spacing: 1.5px;\n      color: var(--pt-accent2);\n    }\n    [data-parchment] .pt-scene .meta span { opacity: 0.95; }\n    [data-parchment] .pt-scene .ex {\n      margin-top: 9px;\n      font-size: 13px; color: var(--pt-text); opacity: 0.75;\n      line-height: 1.9; font-style: italic;\n    }\n\n  /* ===== 花括号头像（图床：本地酒馆静态目录 / GitHub 仓库备份）===== */\n  img.pt-av { display:inline-block; vertical-align:middle; width:64px; height:64px;\n    object-fit:cover; border-radius:12px; margin:2px 6px; background:#fff;\n    border:1px solid rgba(128,128,128,.45); box-shadow:0 2px 8px rgba(0,0,0,.35); }\n  img.pt-av[data-n=\"艾莉卡·冯·艾森\"] { content: url(\"h