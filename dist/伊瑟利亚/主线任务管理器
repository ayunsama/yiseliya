@@preprocessing
<%
// 安全声明 isFloorZero（避免 ReferenceError）
var isFloorZero = typeof isFloorZero !== 'undefined' ? isFloorZero : false;

// 读取任务列表变量
var tasks = getvar('stat_data.主角.任务', { defaults: {} });

// 中文数字映射（已扩展至二十，后续可自行补加）
var cnNums = [
  '零', '一', '二', '三', '四', '五', '六', '七', '八', '九', '十',
  '十一', '十二', '十三', '十四', '十五', '十六', '十七', '十八', '十九', '二十'
];

// 安全加载函数
async function safeGetWI(entryName) {
  try {
    if (!entryName) return '';
    var content = await getwi(entryName);
    return content || '';
  } catch (e) {
    return '';
  }
}

if (!isFloorZero) {
  var activeTaskName = null;
  var hasCompleted = false;

  for (const taskName in tasks) {
    if (tasks.hasOwnProperty(taskName) && taskName.includes('当前主线')) {
      var taskInfo = tasks[taskName];

      if (taskInfo.状态 === '已完成') {
        hasCompleted = true;
        var match = taskName.match(/第(.+)章/);

        if (match && match[1]) {
          var currentIndex = cnNums.indexOf(match[1]);
          if (currentIndex !== -1 && currentIndex < cnNums.length - 1) {
            var nextNumStr = cnNums[currentIndex + 1];
            var nextTaskName = '当前主线·第' + nextNumStr + '章';
            %>
            <%- await safeGetWI(nextTaskName) %>
            <%
          }
          // 若已是最后一章，不输出任何新章节（可自行扩展结局提示）
        } else if (taskName.includes('序章')) {
          %>
          <%- await safeGetWI('当前主线·第一章') %>
          <%
        }
        // 发现已完成任务即停止循环，避免重复输出
        break;
      } else {
        activeTaskName = taskName;
      }
    }
  }

  // 没有已完成任务，则输出当前进行中的主线
  if (!hasCompleted && activeTaskName) {
    %>
    <%- await safeGetWI(activeTaskName) %>
    <%
  }
}
%>