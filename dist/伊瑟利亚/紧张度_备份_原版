  }

  // ---- 构建窗口 HTML ----
  function buildWindowHtml(d) {
    const newsHtml = d.news.map(n =>
      '<div class="tw-news"><div class="tw-news-head"><span class="tw-news-imp imp-' + escapeHtml(n.imp) + '">' + escapeHtml(n.imp) + '</span><span class="tw-news-title">' + escapeHtml(n.title) + '</span>' + (n.date ? '<span class="tw-news-date">' + escapeHtml(n.date) + '</span>' : '') + '</div><div class="tw-news-content">' + escapeHtml(n.content) + (n.place ? '（' + escapeHtml(n.place) + '）' : '') + '</div></div>'
    ).join('');
    const tasksHtml = d.tasks.length ? '<div class="tw-sec"><div class="tw-sec-title">✦ 进行中的任务</div><div class="tw-text">' + escapeHtml(d.tasks.join('；')) + '</div></div>' : '';
    const briefHtml = d.worldBrief ? '<div class="tw-sec"><div class="tw-sec-title">✦ 世界概况</div><div class="tw-text">' + escapeHtml(d.worldBrief) + '</div></div>' : '';
    const newsSecHtml = d.news.length ? '<div class="tw-sec"><div class="tw-sec-title">✦ 近期重要动态</div>' + newsHtml + '</div>' : '';
    const dynHtml = d.dyn ? '<div class="tw-sec"><div class="tw-sec-title">✦ 世界态势（' + escapeHtml(d.level) + '）</div><div class="tw-dyn">' + dynToHtml(d.dyn) + '</div></div>' : '';
    const injectHtml = '<div class="tw-sec"><div class="tw-sec-title">✦ 注入正文</div>' +
      '<label class="tw-check"><input type="checkbox" id="twInjectCtx"' + (injectToContext ? ' checked' : '') + '> 注入世界动态到正文</label>' +
      '<label class="tw-check"><input type="checkbox" id="twInjectLive"' + (injectLiveToContext ? ' checked' : '') + '> 注入实时变化到正文</label>' +
      '<label class="tw-check tw-check-mt">每 <input id="twForecastInterval" type="number" min="0" step="1" value="' + forecastIntervalFloor + '" style="width:4rem; margin:0 6px;"> 楼推演一次（0=仅紧张度变化触发）</label>' +
      '<div class="tw-meta">开启后，世界动态与生成的实时变化会在每次 AI 生成时注入上下文，让正文叙事自然体现当前局势。推演触发条件可通过上方设置调整。</div>' +
      '</div>';
    const promptHtml = '<div class="tw-sec"><div class="tw-sec-title">✦ 影响推演提示词</div>' +
      '<textarea class="tw-area" id="twImpactPrompt" rows="5" spellcheck="false">' + escapeHtml(impactPrompt || DEFAULT_IMPACT_PROMPT) + '</textarea>' +
      '<button class="tw-btn tw-btn-mini" id="twResetPrompt" type="button">↺ 恢复默认</button>' +
      '<div class="tw-meta">用于正文注入与窗口推演的【生成要求】；支持 {地点} 占位符（自动替换为当前所在地）。修改后点击别处即保存。</div>' +
      '</div>';
    return '' +
      '<div class="tw-close" title="关闭">✕</div>' +
      '<div class="tw-title">◈ 世 界 动 态 ◈</div>' +
      '<div class="tw-body">' +
        '<div class="tw-sec"><div class="tw-sec-title">✦ 紧张度变化</div>' +
          '<div class="tw-tension-row"><span class="tw-num">' + d.tension + '</span><span class="tw-level">' + escapeHtml(d.level) + '</span><span class="tw-delta" id="twDelta">—</span></div>' +
          '<div class="tw-meta">上次大事件：' + escapeHtml(d.lastEvent) + '</div>' +
        '</div>' +
        briefHtml + tasksHtml + newsSecHtml + dynHtml +
        injectHtml +
        promptHtml +
        '<div class="tw-sec"><div class="tw-sec-title">✦ 事件推演 · 此地将要发生什么</div>' +
          '<div class="tw-live" id="twLive">' + escapeHtml(forecastCache && forecastCache.内容 ? ((forecastCache.地点 ? '【' + forecastCache.地点 + '】' : '') + forecastCache.内容) : '（尚无推演；脚本会在 地点/时间/紧张度/新闻/正文 变化时自动推演并注入上下文）') + '</div>' +
          '<button class="tw-btn tw-btn-mini" id="twGenBtn" type="button">🔮 立即推演</button> ' +
          '<span class="tw-meta">' + (forecastCache && forecastCache.推演时间 ? '最近推演：' + new Date(forecastCache.推演时间).toLocaleString() + ' · ' : '') + '推演结果会作为【事件推演】注入每次 AI 生成的上下文。</span>' +
        '</div>' +
      '</div>';
  }

  // ---- 紧张度变化检测（localStorage 对比上次查看） ----
  function detectTensionDelta(panel, cur) {
    const el = panel.querySelector('#twDelta');
    if (!el) return;
    let last = null;
    try { last = JSON.parse(localStorage.getItem(TENSION_VIEW_KEY) || 'null'); } catch (e) {}
    if (!last || typeof last.value !== 'number') {
      el.textContent = '—';
    } else {
      const diff = cur - last.value;
      if (diff > 0) { el.textContent = '↑ +' + diff; el.className = 'tw-delta delta-up'; }
      else if (diff < 0) { el.textContent = '↓ ' + diff; el.className = 'tw-delta delta-down'; }
      else { el.textContent = '→ 0'; el.className = 'tw-delta delta-flat'; }
    }
    try { localStorage.setItem(TENSION_VIEW_KEY, JSON.stringify({ value: cur, at: Date.now() })); } catch (e) {}
  }

  // ---- 打开 / 关闭窗口 ----
  async function openTensionWindow() {
    closeTensionWindow();
    const d = extractTensionData(readStatData());
    d.dyn = await getDynText(d.level);
    if (d.dyn) cachedDyn = d.dyn;
    ensureTensionStyle();
    const doc = outerDoc();
    const $mask = $(doc.createElement('div')).attr('class', 'tw-mask');
    $mask.html('<div class="tw-panel">' + buildWindowHtml(d) + '</div>');
    $(outerBody()).append($mask);
    const panel = $mask.find('.tw-panel')[0];
    detectTensionDelta(panel, d.tension);
    // 动态剧情超过可视区（约 300 字）时，提示可向下滚动查看完整世界态势
    const dynEl = panel.querySelector('.tw-dyn');
    if (dynEl && dynEl.scrollHeight > dynEl.clientHeight) {
      const hint = doc.createElement('div');
      hint.className = 'tw-dyn-hint';
      hint.textContent = '▾ 已显示部分（约 300 字），向下滚动查看完整世界态势';
      dynEl.parentNode.insertBefore(hint, dynEl.nextSibling);
    }
    $mask.on('click', function (e) { if (e.target === $mask[0]) closeTensionWindow(); });
    $(panel).find('.tw-close').on('click', closeTensionWindow);
    $(panel).find('#twInjectCtx').on('change', function () { injectToContext = this.checked; saveInjectSettings(); });
    $(panel).find('#twInjectLive').on('change', function () { injectLiveToContext = this.checked; saveInjectSettings(); });
    $(panel).find('#twImpactPrompt').on('change', function () {
      impactPrompt = String(this.value || '').trim() || DEFAULT_IMPACT_PROMPT;
      saveImpactPrompt();
    });
    $(panel).find('#twResetPrompt').on('click', function () {
      impactPrompt = DEFAULT_IMPACT_PROMPT;
      saveImpactPrompt();
      const ta = doc.getElementById('twImpactPrompt');
      if (ta) ta.value = DEFAULT_IMPACT_PROMPT;
      if (typeof toastr !== 'undefined') toastr.info('已恢复默认影响推演提示词', '世界动态');
    });
    $(panel).find('#twForecastInterval').on('change', function () {
      const value = Number(this.value);
      forecastIntervalFloor = Number.isInteger(value) && value >= 0 ? value : DEFAULT_FORECAST_INTERVAL_FLOOR;
      if (!Number.isInteger(value) || value < 0) {
        this.value = String(DEFAULT_FORECAST_INTERVAL_FLOOR);
      }
      saveForecastSettings();
    });
    // 若有推演缓存则刷新展示
    const liveEl = panel.querySelector('#twLive');
    if (liveEl && forecastCache && forecastCache.内容) {
      liveEl.textContent = (forecastCache.地点 ? '【' + forecastCache.地点 + '】' : '') + String(forecastCache.内容);
    }
    // 立即推演按钮：手动触发一次推演并刷新展示/注入
    $(panel).find('#twGenBtn').on('click', async function () {
      const btn = this;
      btn.disabled = true;
      btn.textContent = '推演中…';
      try {
        const text = await runForecast();
        const el = panel.querySelector('#twLive');
        if (el && text) el.textContent = (forecastCache && forecastCache.地点 ? '【' + forecastCache.地点 + '】' : '') + text;
        if (typeof toastr !== 'undefined') toastr.success('已重新推演并注入上下文', '世界动态');
      } catch (e) {
        const el = panel.querySelector('#twLive');
        if (el) el.textContent = '推演失败：' + (e && e.message ? e.message : e);
      }
      btn.disabled = false;
      btn.textContent = '🔮 立即推演';
    });
  }

  function closeTensionWindow() {
    try {
      const mask = outerDoc().querySelector('.tw-mask');
      if (mask) mask.remove();
    } catch (e) {}
  }

  $(init);
})();
